---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedPath, type Locale } from "../lib/locale";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const copy = locale === "nl" ? {
	label: "Lineage", heading: "Lijn van overdracht", intro: "Lama Tenzin Samphel Rinpoche geeft onderricht binnen de Nyingma-traditie van het Tibetaans boeddhisme. Hij houdt verschillende overdrachtslijnen en beoefeningscycli binnen deze traditie en draagt deze over.",
	traditionHeading: "De Nyingma-traditie", tradition: ["Nyingma is de oudste van de belangrijkste tradities van het Tibetaans boeddhisme. Door de eeuwen heen zijn de onderrichtingen en beoefeningen ervan bewaard gebleven en al generaties lang van leraar op leerling overgedragen.", "De Nyingma-traditie omvat zowel lang bestaande overdrachtslijnen als terma-tradities — onthulde onderrichtingen en beoefeningscycli die een belangrijk onderdeel van haar erfgoed vormen."],
	trainingHeading: "Rinpoche’s opleiding en overdracht", training: ["Lama Tenzin Samphel Rinpoche ontving onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies van meesters onder wie Kyabjé Dudjom Rinpoche, Dilgo Khyentse Rinpoche, Chadral Rinpoche en Khetsun Sangpo Rinpoche.", "Binnen de Nyingma-traditie houdt en draagt hij verschillende overdrachtslijnen en beoefeningscycli, waaronder de volledige overdracht van Dudjom Tersar, Longchen Nyingtik en Yangti Nakpo. In 1999 benoemde Khetsun Sangpo Rinpoche hem tot lineagehouder en vertrouwde hem de spirituele verantwoordelijkheid over Shedup Kunsang Chöling toe."],
	trainingContext: "Hoewel Rinpoche voornamelijk binnen de Nyingma-traditie onderricht geeft, staat zijn opleiding in een bredere niet-sektarische, of Rimé, benadering van het Tibetaans boeddhisme. Hij ontving gedurende zijn opleiding onderricht en overdrachten van meesters uit verschillende Tibetaanse tradities, terwijl de Nyingma- en in het bijzonder de Dudjom Tersar-overdracht een centrale plaats in zijn eigen onderricht innemen.",
	tersar: ["Dudjom Tersar is een terma-traditie binnen de Nyingma-school van het Tibetaans boeddhisme, verbonden met Dudjom Lingpa en Dudjom Rinpoche, Jigdral Yeshe Dorje. Het is geen afzonderlijke school, maar een geheel van onderrichtingen en beoefeningscycli die binnen de bredere Nyingma-traditie worden overgedragen.", "Dudjom Tersar neemt een centrale plaats in binnen veel van de beoefeningen, inwijdingen, mondelinge overdrachten en het onderricht dat Lama Tenzin Samphel Rinpoche geeft via activiteiten van Padma Pura Foundation."],
	longchenHeading: "Longchen Nyingtik", longchen: "Longchen Nyingtik (Wyl. klong chen snying thig) is een Nyingma-cyclus van onderricht en beoefening die door Jikmé Lingpa als mind terma werd geopenbaard.",
	yangtiHeading: "Yangti Nakpo", yangti: "Yangti Nakpo (Wyl. yang ti nag po), de “Black Quintessence”, is een cyclus van Dzogchen-onderricht. De volledige titel is The Single Golden Letter of the Black Quintessence (yang ti nag po gser gyi 'bru gcig). De cyclus omvat onder andere beoefeningen die verbonden zijn met dark retreat (Yangti).",
	livingHeading: "Levende overdracht", living: ["Door zijn Dharma-activiteit blijft Lama Tenzin Samphel Rinpoche de onderrichtingen en beoefeningscycli die hij heeft ontvangen en beoefend overdragen, door middel van onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies.", "Padma Pura Foundation ondersteunt deze activiteiten in Nederland en helpt de praktische voorwaarden te scheppen voor Rinpoche’s bezoeken en voor studenten om zijn begeleiding te ontvangen en samen te beoefenen."],
	captionKhetsun: "Khetsun Sangpo Rinpoche", captionDudjom: "Dudjom Lingpa", captionRinpoche: "Kyabjé Dudjom Rinpoche",
	imageAltKhetsun: "Khetsun Sangpo Rinpoche", imageAltDudjom: "Dudjom Lingpa", imageAltRinpoche: "Kyabjé Dudjom Rinpoche",
	tersarHeading: "Dudjom Tersar",
} : {
	label: "Lineage", heading: "Lineage & Transmission", intro: "Lama Tenzin Samphel Rinpoche teaches within the Nyingma tradition of Tibetan Buddhism. He holds and transmits several transmission lineages and practice cycles within that tradition.",
	traditionHeading: "The Nyingma tradition", tradition: ["Nyingma is the oldest of the major traditions of Tibetan Buddhism. Over many centuries, its teachings and practices have been preserved and transmitted through numerous lineages and practice cycles.", "The Nyingma tradition includes both long-established transmission lineages and terma traditions — revealed teachings and practice cycles that form an important part of its heritage."],
	trainingHeading: "Rinpoche's training and transmission", training: ["Lama Tenzin Samphel Rinpoche received teachings, empowerments, oral transmissions and practice instructions from masters including Kyabjé Dudjom Rinpoche, Dilgo Khyentse Rinpoche, Chadral Rinpoche and Khetsun Sangpo Rinpoche.", "Within the Nyingma tradition, he holds and transmits several transmission lineages and practice cycles, including the complete transmission of Dudjom Tersar, Longchen Nyingtik and Yangti Nakpo. In 1999, Khetsun Sangpo Rinpoche enthroned him as a lineage holder and entrusted him with spiritual authority at Shedup Kunsang Chöling."],
	trainingContext: "Although Rinpoche teaches primarily within the Nyingma tradition, his training also reflects a broader non-sectarian, or Rimé, approach to Tibetan Buddhism. During his training he received teachings and transmissions from masters of different Tibetan traditions, while the Nyingma tradition, and Dudjom Tersar in particular, remains central to his own teaching activity.",
	tersar: ["Dudjom Tersar is a terma tradition within the Nyingma school of Tibetan Buddhism, associated with Dudjom Lingpa and Dudjom Rinpoche, Jigdral Yeshe Dorje. It is not a separate school, but a body of teachings and practice cycles transmitted within the wider Nyingma tradition.", "Dudjom Tersar has a central place in many of the practices, empowerments, oral transmissions and teachings that Lama Tenzin Samphel Rinpoche gives through Padma Pura Foundation activities."],
	longchenHeading: "Longchen Nyingtik", longchen: "Longchen Nyingtik (Wyl. klong chen snying thig) is a Nyingma cycle of teachings and practice, revealed by Jikmé Lingpa as mind terma.",
	yangtiHeading: "Yangti Nakpo", yangti: "Yangti Nakpo (Wyl. yang ti nag po), the Black Quintessence, or in full The Single Golden Letter of the Black Quintessence (yang ti nag po gser gyi 'bru gcig), is a cycle of Dzogchen teachings that includes practices focusing on dark retreat (Yangti).",
	livingHeading: "Living transmission", living: ["Through his Dharma activity, Lama Tenzin Samphel Rinpoche continues to transmit the teachings and practice cycles he has received and practised, through teachings, empowerments, oral transmissions and practice guidance.", "Padma Pura Foundation supports this activity in the Netherlands, helping create the practical conditions for Rinpoche's visits and for students to receive his guidance and practise together."],
	captionKhetsun: "Khetsun Sangpo Rinpoche", captionDudjom: "Dudjom Lingpa", captionRinpoche: "Kyabjé Dudjom Rinpoche",
	imageAltKhetsun: "Khetsun Sangpo Rinpoche", imageAltDudjom: "Dudjom Lingpa", imageAltRinpoche: "Kyabjé Dudjom Rinpoche",
	tersarHeading: "Dudjom Tersar",
};
const localizedPath = (path: string) => getLocalizedPath(path, locale);
---

<BaseLayout
	title="Lineage & Transmission | Padma Pura Foundation"
	description="The Nyingma tradition and the transmission lineages and practice cycles held by Lama Tenzin Samphel Rinpoche, taught through Padma Pura Foundation."
>
	<section class="lineage-opening" aria-labelledby="lineage-heading">
		<p class="lineage-opening__label">{copy.label}</p>
		<h1 id="lineage-heading">{copy.heading}</h1>
		<p class="lineage-opening__intro">{copy.intro}</p>
	</section>

	<section class="nyingma" aria-labelledby="nyingma-heading">
		<h2 id="nyingma-heading">{copy.traditionHeading}</h2>
		<div class="nyingma__prose">
			{copy.tradition.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>



	<section class="rinpoche-transmission" aria-labelledby="rinpoche-transmission-heading">
		<h2 id="rinpoche-transmission-heading">{copy.trainingHeading}</h2>
		<div class="rinpoche-transmission__prose">
			{copy.training.map((paragraph) => <p>{paragraph}</p>)}
			<p>{copy.trainingContext}</p>
		</div>
		<figure class="lineage__contextual-media">
			<img src="/images/lineage/khetsun-sangpo-rinpoche.jpg" alt="Khetsun Sangpo Rinpoche" />
			<figcaption>{copy.captionKhetsun}</figcaption>
		</figure>
	</section>

	<section class="dudjom-tersar" aria-labelledby="dudjom-tersar-heading">
		<h2 id="dudjom-tersar-heading">{copy.tersarHeading}</h2>
		<div class="dudjom-tersar__prose">
			{copy.tersar.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<div class="lineage__portrait-pair">
			<figure>
				<img src="/images/lineage/Dudjom_Lingpa.jpg" alt="Dudjom Lingpa" />
				<figcaption>{copy.captionDudjom}</figcaption>
			</figure>
			<figure>
				<img src="/images/lineage/dudjom-rinpoche.webp" alt="Kyabjé Dudjom Rinpoche" />
				<figcaption>{copy.captionRinpoche}</figcaption>
			</figure>
		</div>
	</section>

	<section class="secondary-cycle" aria-labelledby="longchen-heading">
		<div class="secondary-cycle__content">
			<h2 id="longchen-heading">{copy.longchenHeading}</h2>
			<div class="secondary-cycle__prose">
				<p>{copy.longchen}</p>
			</div>
		</div>
		<figure class="secondary-cycle__image">
			<img src="/images/lineage/jigme-lingpa.webp" alt="Jigme Lingpa" loading="lazy" decoding="async" />
			<figcaption>Jigme Lingpa</figcaption>
		</figure>
	</section>

	<section class="secondary-cycle secondary-cycle--reversed" aria-labelledby="yangti-heading">
		<div class="secondary-cycle__content">
			<h2 id="yangti-heading">{copy.yangtiHeading}</h2>
			<div class="secondary-cycle__prose">
				<p>{copy.yangti}</p>
			</div>
		</div>
		<figure class="secondary-cycle__image">
			<img src="/images/lineage/shuksep-lochen-chonyi-zangmo.webp" alt="Shuksep Lochen Chönyi Zangmo" loading="lazy" decoding="async" />
			<figcaption>Shuksep Lochen Chönyi Zangmo</figcaption>
		</figure>
	</section>

	<section class="living-transmission" aria-labelledby="living-transmission-heading">
		<h2 id="living-transmission-heading">{copy.livingHeading}</h2>
		<div class="living-transmission__prose">
			{copy.living.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>
</BaseLayout>

<style>
	.lineage-opening {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-8), 8vw, 7.5rem);
		margin-inline: auto;
	}

	.lineage-opening__label {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.lineage-opening h1 {
		max-width: 16ch;
		margin: var(--space-6) 0 0;
		font-family: var(--font-display);
		font-size: clamp(3rem, 5.5vw, 5.5rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 1.02;
		font-optical-sizing: auto;
	}

	.lineage-opening__intro {
		max-width: 42rem;
		margin: clamp(var(--space-5), 3vw, var(--space-7)) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.nyingma {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.nyingma h2,
	.nyingma p {
		margin: 0;
	}

	.nyingma h2 {
		margin-bottom: var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.nyingma__prose {
		max-width: 42rem;
	}

	.nyingma p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.nyingma p + p {
		margin-top: var(--space-6);
	}

	.rinpoche-transmission {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.rinpoche-transmission h2,
	.rinpoche-transmission p {
		margin: 0;
	}

	.rinpoche-transmission h2 {
		margin-bottom: var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.rinpoche-transmission__prose {
		max-width: 42rem;
	}

	.rinpoche-transmission p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.rinpoche-transmission p + p {
		margin-top: var(--space-6);
	}

	.lineage__contextual-media {
		display: block;
		width: 40%;
		max-width: 20rem;
		height: auto;
		margin-top: clamp(var(--space-6), 4vw, var(--space-7));
	}

	.lineage__contextual-media img,
	.lineage__portrait-pair img {
		display: block;
		width: 100%;
		height: auto;
	}

	.lineage__contextual-media,
	.lineage__portrait-pair figure {
		margin-inline: 0;
		margin-bottom: 0;
	}

	.lineage__contextual-media figcaption,
	.lineage__portrait-pair figcaption,
	.secondary-cycle__image figcaption {
		margin-top: var(--space-2);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.4;
		text-align: left;
	}

	.lineage__portrait-pair {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(var(--space-4), 3vw, var(--space-6));
		width: 80%;
		max-width: 40rem;
		margin-top: clamp(var(--space-6), 4vw, var(--space-7));
	}

	.dudjom-tersar {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.dudjom-tersar h2 {
		max-width: 20ch;
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(3rem, 4vw, 3.5rem);
		font-weight: 380;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.dudjom-tersar__prose,
	.secondary-cycle__prose {
		max-width: 44rem;
	}

	.dudjom-tersar__prose p,
	.secondary-cycle__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.dudjom-tersar__prose p + p,
	.secondary-cycle__prose p + p {
		margin-top: var(--space-6);
	}

	.dudjom-tersar__note {
		max-width: 44rem;
		margin: var(--space-7) 0 0 clamp(1.5rem, 6vw, 5rem);
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.secondary-cycle {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
		gap: clamp(var(--space-6), 6vw, var(--space-8));
		align-items: center;
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-6), 5vw, var(--space-7));
		margin-inline: auto;
	}

	.secondary-cycle--reversed {
		grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
	}

	.secondary-cycle--reversed .secondary-cycle__content {
		grid-column: 2;
		grid-row: 1;
	}

	.secondary-cycle--reversed .secondary-cycle__image {
		grid-column: 1;
		grid-row: 1;
	}

	.secondary-cycle h2 {
		max-width: 20ch;
		margin: 0 0 var(--space-5);
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 3.2vw, 3rem);
		font-weight: 380;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.secondary-cycle__image {
		width: 100%;
		max-width: 18rem;
		margin: 0;
		justify-self: center;
	}

	.secondary-cycle__image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.secondary-cycle__image figcaption {
		text-align: center;
	}

	.living-transmission {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 6vw, var(--space-8));
		margin-inline: auto;
	}

	.living-transmission h2 {
		margin: 0 0 var(--space-7);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.living-transmission__prose {
		max-width: 42rem;
	}

	.living-transmission__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.living-transmission__prose p + p {
		margin-top: var(--space-6);
	}

	@media (max-width: 48rem) {
		.lineage-opening {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.lineage-opening h1 {
			max-width: none;
			margin: var(--space-5) 0 0;
			font-size: clamp(2.5rem, 11vw, 3.5rem);
			line-height: 1.05;
		}

		.lineage-opening__intro {
			max-width: none;
			margin: var(--space-6) 0 0;
			font-size: var(--text-base);
		}

		.nyingma {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.nyingma h2 {
			padding: 0 0 var(--space-6);
		}

		.nyingma p {
			font-size: var(--text-base);
		}

		.rinpoche-transmission {
			display: flex;
			flex-direction: column;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.rinpoche-transmission h2 {
			padding: 0;
		}

		.rinpoche-transmission p {
			font-size: var(--text-base);
		}

		.dudjom-tersar {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.dudjom-tersar h2 {
			max-width: none;
			margin: 0 0 var(--space-6);
			font-size: clamp(2.25rem, 9vw, 2.75rem);
		}

		.dudjom-tersar__prose {
			max-width: none;
			margin-left: 0;
		}

		.lineage__contextual-media {
			width: 76%;
			max-width: 18rem;
			margin: var(--space-7) auto 0;
		}

		.lineage__portrait-pair {
			display: block;
			width: 76%;
			max-width: 18rem;
			margin: var(--space-7) auto 0;
		}

		.lineage__portrait-pair figure + figure {
			margin-top: var(--space-6);
		}

		.dudjom-tersar__prose p {
			font-size: var(--text-base);
		}

		.dudjom-tersar__note {
			max-width: none;
			margin: var(--space-6) 0 0;
		}

		.secondary-cycle {
			grid-template-columns: minmax(0, 1fr) minmax(12rem, 40%);
			gap: var(--space-6);
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-8);
		}

		.secondary-cycle--reversed {
			grid-template-columns: minmax(12rem, 40%) minmax(0, 1fr);
		}

		.secondary-cycle h2 {
			max-width: none;
			margin: 0 0 var(--space-5);
			font-size: clamp(2.125rem, 5vw, 2.5rem);
		}

		.secondary-cycle--reversed .secondary-cycle__content {
			grid-column: 2;
			grid-row: 1;
		}

		.secondary-cycle--reversed .secondary-cycle__image {
			grid-column: 1;
			grid-row: 1;
		}

		.secondary-cycle__image {
			max-width: 100%;
		}
	}

	@media (max-width: 40rem) {
		.secondary-cycle,
		.secondary-cycle--reversed {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}

		.secondary-cycle--reversed .secondary-cycle__content,
		.secondary-cycle--reversed .secondary-cycle__image {
			grid-column: 1;
			grid-row: auto;
		}

		.secondary-cycle__image {
			width: min(76%, 18rem);
			justify-self: center;
		}

		.living-transmission {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-7);
		}

		.living-transmission h2 {
			padding: 0 0 var(--space-6);
		}

		.living-transmission__prose p {
			font-size: var(--text-base);
		}
	}
</style>
