---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedPath, type Locale } from "../lib/locale";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const copy = locale === "nl" ? {
	label: "Stichting", opening: ["Padma Pura Foundation ondersteunt de Dharma-activiteit van Tenzin Samphel Rinpoche in Nederland.", "Door praktische organisatie, communicatie en ondersteuning door vrijwilligers helpt de stichting de voorwaarden te scheppen voor Rinpoche’s bezoeken, onderricht, overdrachten en beoefeningsactiviteiten."],
	purposeHeading: "Onze doelstelling", purpose: ["Padma Pura Foundation bestaat om Rinpoche’s Dharma-activiteit in Nederland te ondersteunen en het voor studenten mogelijk te maken zijn onderricht en begeleiding te ontvangen en samen te beoefenen.", "De rol van de stichting is praktisch en ondersteunend: bezoeken organiseren, onderricht en overdrachten faciliteren, beoefeningsactiviteiten ondersteunen en zorgen voor de voorwaarden waaronder deze activiteiten kunnen plaatsvinden."],
	workHeading: "Hoe we werken", work: ["Padma Pura Foundation wordt ondersteund door een kleine groep mensen in Nederland die zorgt voor de praktische organisatie rond Rinpoche’s Dharma-activiteit.", "Dit omvat het coördineren van bezoeken, communicatie, beoefeningsactiviteiten, accommodatie en andere praktische ondersteuning. Veel van dit werk wordt gedaan door vrijwilligers en studenten die waar nodig hun tijd en vaardigheden bijdragen."],
	activitiesHeading: "Activiteiten die we ondersteunen", activities: "De stichting ondersteunt Rinpoche’s jaarlijkse bezoeken aan Nederland, onderricht en overdrachten, en beoefeningsactiviteiten zoals Tsog, Tsetar en Gutor.", activitiesLink: "Ontdek Dharma-activiteiten →",
	anbiHeading: "Stichting & ANBI", anbi: ["Padma Pura Foundation is een Nederlandse stichting met ANBI-status.", "Informatie over de stichting, het bestuur, het beleid en andere formele documenten is beschikbaar op de pagina Stichting & ANBI."], anbiLink: "Stichting & ANBI →",
	supportHeading: "Steun", support: "Padma Pura Foundation is afhankelijk van de steun van studenten, beoefenaars en anderen die helpen Rinpoche’s Dharma-activiteit in Nederland mogelijk te maken.", supportLink: "Steun Padma Pura Foundation →",
} : {
	label: "Foundation", opening: ["Padma Pura Foundation supports the Dharma activity of Tenzin Samphel Rinpoche in the Netherlands.", "Through practical organisation, communication and volunteer support, the foundation helps create the conditions for Rinpoche’s visits, teachings, transmissions and practice activities."],
	purposeHeading: "Our purpose", purpose: ["Padma Pura Foundation exists to support Rinpoche’s Dharma activity in the Netherlands and to help make it possible for students to receive his teachings and guidance and to practise together.", "Its role is practical and supportive: organising visits, facilitating teachings and transmissions, supporting practice activities and taking care of the conditions that allow these activities to take place."],
	workHeading: "How we work", work: ["Padma Pura Foundation is supported by a small group of people in the Netherlands who take care of the practical organisation around Rinpoche’s Dharma activity.", "This includes coordinating visits, communication, practice activities, accommodation and other practical support. Much of this work is carried by volunteers and students who contribute their time and skills where needed."],
	activitiesHeading: "Activities we support", activities: "The foundation supports Rinpoche’s annual visits to the Netherlands, teachings and transmissions, and practice activities including Tsog, Tsetar and Gutor.", activitiesLink: "Explore Dharma Activity →",
	anbiHeading: "Foundation & ANBI", anbi: ["Padma Pura Foundation is a Dutch foundation with ANBI status.", "Information about the foundation, its board, policy and other formal documents is available on the Foundation & ANBI page."], anbiLink: "Foundation & ANBI →",
	supportHeading: "Support", support: "Padma Pura Foundation depends on the support of students, practitioners and others who help make Rinpoche’s Dharma activity in the Netherlands possible.", supportLink: "Support Padma Pura Foundation →",
};
const localizedPath = (path: string) => getLocalizedPath(path, locale);
---

<BaseLayout
	title="Padma Pura Foundation"
	description="Padma Pura Foundation supports the Dharma activity of Tenzin Samphel Rinpoche in the Netherlands."
>
	<section class="pp-opening" aria-labelledby="pp-heading">
		<p class="pp-opening__label">{copy.label}</p>
		<h1 id="pp-heading">Padma Pura Foundation</h1>
		<div class="pp-opening__intro">
			{copy.opening.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section class="purpose" aria-labelledby="purpose-heading">
		<h2 id="purpose-heading">{copy.purposeHeading}</h2>
		<div class="purpose__prose">
			{copy.purpose.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section class="how-we-work" aria-labelledby="how-we-work-heading">
		<h2 id="how-we-work-heading">{copy.workHeading}</h2>
		<div class="how-we-work__prose">
			{copy.work.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section class="activities-we-support" aria-labelledby="activities-we-support-heading">
		<h2 id="activities-we-support-heading">{copy.activitiesHeading}</h2>
		<div class="activities-we-support__prose">
			<p>{copy.activities}</p>
		</div>
		<p class="activities-we-support__link"><a href={localizedPath("/activities")}>{copy.activitiesLink}</a></p>
	</section>

	<section class="foundation-anbi-summary" aria-labelledby="foundation-anbi-summary-heading">
		<h2 id="foundation-anbi-summary-heading">{copy.anbiHeading}</h2>
		<div class="foundation-anbi-summary__prose">
			{copy.anbi.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<p class="foundation-anbi-summary__link"><a href={localizedPath("/foundation")}>{copy.anbiLink}</a></p>
	</section>

	<section class="support-summary" aria-labelledby="support-summary-heading">
		<h2 id="support-summary-heading">{copy.supportHeading}</h2>
		<div class="support-summary__prose">
			<p>{copy.support}</p>
		</div>
		<p class="support-summary__link"><a href={localizedPath("/support")}>{copy.supportLink}</a></p>
	</section>
</BaseLayout>

<style>
	.pp-opening {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-7), 8vw, 8rem);
		margin-inline: auto;
	}

	.pp-opening__label {
		margin: 0 0 var(--space-6);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.pp-opening h1 {
		max-width: 16ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 6.5vw, 6rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 0.98;
		font-optical-sizing: auto;
	}

	.pp-opening__intro {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(var(--space-6), 5vw, var(--space-8));
		max-width: none;
		margin-top: clamp(var(--space-7), 6vw, var(--space-9));
	}

	.pp-opening__intro p {
		max-width: 34rem;
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.pp-opening__intro p:last-child {
		margin: 0;
	}

	.purpose {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.purpose h2,
	.purpose p {
		margin: 0;
	}

	.purpose h2 {
		margin-bottom: var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.purpose__prose {
		max-width: 42rem;
	}

	.purpose p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.purpose p + p {
		margin-top: var(--space-6);
	}

	.how-we-work {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.how-we-work h2 {
		max-width: none;
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.how-we-work__prose {
		max-width: 42rem;
	}

	.how-we-work__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.how-we-work__prose p + p {
		margin-top: var(--space-6);
	}

	.activities-we-support {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.activities-we-support h2 {
		max-width: none;
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.activities-we-support__prose {
		max-width: 38rem;
	}

	.activities-we-support__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.activities-we-support__prose p + p {
		margin-top: var(--space-5);
	}

	.activities-we-support__link {
		margin: var(--space-6) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 500;
	}

	.foundation-anbi-summary {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.foundation-anbi-summary h2 {
		max-width: none;
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.foundation-anbi-summary__prose {
		max-width: 32rem;
	}

	.foundation-anbi-summary__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.foundation-anbi-summary__prose p + p {
		margin-top: var(--space-5);
	}

	.foundation-anbi-summary__link {
		margin: var(--space-5) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
	}

	.support-summary {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-8), 8vw, 7.5rem);
		margin-inline: auto;
	}

	.support-summary h2 {
		max-width: none;
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.support-summary__prose {
		max-width: 36rem;
	}

	.support-summary__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.support-summary__link {
		margin: var(--space-5) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 500;
	}

	@media (max-width: 48rem) {
		.pp-opening {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.pp-opening h1 {
			max-width: none;
			font-size: clamp(2.75rem, 12vw, 4rem);
			line-height: 1.02;
		}

		.pp-opening__intro {
			display: block;
			margin-top: var(--space-7);
		}

		.pp-opening__intro p {
			max-width: none;
			font-size: var(--text-base);
		}

		.pp-opening__intro p:last-child {
			margin: var(--space-6) 0 0;
		}

		.purpose {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.purpose p {
			font-size: var(--text-base);
		}

		.how-we-work {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.how-we-work__prose p {
			font-size: var(--text-base);
		}

		.activities-we-support {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.activities-we-support__prose {
			max-width: none;
		}

		.activities-we-support__prose p {
			font-size: var(--text-base);
		}

		.foundation-anbi-summary {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.foundation-anbi-summary__prose {
			max-width: none;
		}

		.foundation-anbi-summary__prose p {
			font-size: var(--text-base);
		}

		.support-summary {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.support-summary__prose {
			max-width: none;
		}
	}
</style>
