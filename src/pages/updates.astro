---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const updates = await getCollection(
	"updates",
	({ data }) => data.publicationStatus === "published",
);

updates.sort((first, second) => {
	const firstDate = first.data.publishedDate?.getTime() ?? Number.NEGATIVE_INFINITY;
	const secondDate = second.data.publishedDate?.getTime() ?? Number.NEGATIVE_INFINITY;

	return secondDate - firstDate;
});

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: "UTC",
});

const formatDate = (date: Date) => dateFormatter.format(date);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout
	title="Updates | Padma Pura Foundation"
	description="Updates from Padma Pura Foundation about Rinpoche's visits, activities and practical matters in the Netherlands."
>
	<section class="updates-opening" aria-labelledby="updates-heading">
		<p class="updates-opening__label">Updates</p>
		<h1 id="updates-heading">Updates</h1>
		<p class="updates-opening__intro">Updates from Padma Pura Foundation about Rinpoche’s visits, activities and practical matters in the Netherlands.</p>
	</section>

	<section class="updates-list" aria-label="Update entries">
		{updates.length > 0 ? (
			<ul class="updates-entries">
				{updates.map((update) => (
					<li class="updates-entry">
						<div class="updates-entry__content">
							<h2><a href={`/updates/${update.id}`}>{update.data.title}</a></h2>
							<p>{update.data.summary}</p>
						</div>
						{update.data.publishedDate && (
							<time datetime={isoDate(update.data.publishedDate)}>
								{formatDate(update.data.publishedDate)}
							</time>
						)}
					</li>
				))}
			</ul>
		) : (
			<div class="updates-empty">
				<h2>No current updates</h2>
				<p>New updates will be published here when there is confirmed information to share.</p>
			</div>
		)}
	</section>
</BaseLayout>

<style>
	.updates-opening {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-7), 8vw, 8rem);
		margin-inline: auto;
	}

	.updates-opening__label {
		margin: 0 0 var(--space-6);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.updates-opening h1 {
		max-width: 16ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3rem, 5.5vw, 5rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 1.02;
		font-optical-sizing: auto;
	}

	.updates-opening__intro {
		max-width: 34rem;
		margin: clamp(var(--space-6), 5vw, var(--space-7)) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.updates-list {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-9), 10vw, 10rem);
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
	}

	.updates-entries {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.updates-entry {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(9rem, auto);
		gap: var(--space-7);
		align-items: baseline;
		padding-block: var(--space-7);
		border-bottom: 1px solid var(--color-border);
	}

	.updates-entry__content {
		max-width: var(--content-width-narrow);
	}

	.updates-entry h2 {
		margin: 0 0 var(--space-3);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-optical-sizing: auto;
		font-weight: 380;
		line-height: 1.1;
	}

	.updates-entry h2 a {
		color: inherit;
	}

	.updates-entry p {
		margin: 0;
		line-height: 1.6;
	}

	.updates-entry time {
		color: var(--color-muted);
		font-size: var(--text-sm);
		white-space: nowrap;
	}

	.updates-empty {
		max-width: 34rem;
		padding-top: clamp(var(--space-8), 9vw, 9rem);
	}

	.updates-empty h2 {
		margin: 0 0 var(--space-4);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.updates-empty p {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	@media (max-width: 48rem) {
		.updates-opening {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.updates-opening h1 {
			max-width: none;
			font-size: clamp(2.25rem, 10vw, 3rem);
			line-height: 1.05;
		}

		.updates-opening__intro {
			max-width: none;
			margin-top: var(--space-6);
			font-size: var(--text-base);
		}

		.updates-list {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.updates-entry {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}

		.updates-empty {
			max-width: none;
			padding-top: var(--space-8);
		}
	}
</style>
