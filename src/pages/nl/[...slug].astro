---
import ActivitiesPage from "../activities.astro";
import ContactPage from "../contact.astro";
import FoundationPage from "../foundation.astro";
import HomePage from "../index.astro";
import LedenPage from "../leden.astro";
import LineagePage from "../lineage.astro";
import OurTeacherPage from "../our-teacher.astro";
import PadmaPuraPage from "../padma-pura.astro";
import PrivacyPage from "../privacy.astro";
import SupportPage from "../support.astro";
import UpdatesPage from "../updates.astro";
import { staticRoutes } from "../../lib/locale";

export function getStaticPaths() {
	return staticRoutes.map((route) => ({
		params: { slug: route === "/" ? undefined : route.slice(1) },
	}));
}

const pageComponents = {
	"/": HomePage,
	"/our-teacher": OurTeacherPage,
	"/lineage": LineagePage,
	"/activities": ActivitiesPage,
	"/padma-pura": PadmaPuraPage,
	"/leden": LedenPage,
	"/support": SupportPage,
	"/foundation": FoundationPage,
	"/updates": UpdatesPage,
	"/contact": ContactPage,
	"/privacy": PrivacyPage,
} as const;

const route = Astro.params.slug ? `/${Astro.params.slug}` : "/";
const Page = pageComponents[route as keyof typeof pageComponents];
---

{route === "/" ? <HomePage locale="nl" /> : route === "/our-teacher" ? <OurTeacherPage locale="nl" /> : route === "/lineage" ? <LineagePage locale="nl" /> : route === "/activities" ? <ActivitiesPage locale="nl" /> : route === "/padma-pura" ? <PadmaPuraPage locale="nl" /> : route === "/leden" ? <LedenPage /> : route === "/support" ? <SupportPage locale="nl" /> : route === "/foundation" ? <FoundationPage locale="nl" /> : route === "/updates" ? <UpdatesPage locale="nl" /> : route === "/contact" ? <ContactPage locale="nl" /> : route === "/privacy" ? <PrivacyPage locale="nl" /> : Page && <Page />}