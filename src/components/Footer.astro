---
import { getLabels, getLocale, getLocalizedPath } from "../lib/locale";

const locale = getLocale(Astro.url.pathname);
const labels = getLabels(locale);
const primaryLinks = [
	{ href: "/our-teacher", label: labels.ourTeacher },
	{ href: "/lineage", label: labels.lineage },
	{ href: "/activities", label: labels.activities },
	{ href: "/padma-pura", label: labels.foundation },
	{ href: "/support", label: labels.support },
];

const secondaryLinks = [
	{ href: "/foundation", label: labels.foundationAnbi },
	{ href: "/updates", label: labels.updates },
	{ href: "/contact", label: labels.contact },
	{ href: "/privacy", label: labels.privacy },
];
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__identity">
			<a class="site-footer__seal" href={getLocalizedPath("/", locale)} aria-label="Padma Pura Foundation home">
				<img src="/brand/padma-pura-seal.png" alt="Padma Pura Foundation seal" />
			</a>
			<div class="site-footer__brand-copy">
				<p>Padma Pura Foundation</p>
			</div>
		</div>

		<div class="site-footer__navigation">
			<nav class="site-footer__primary" aria-label="Primary footer navigation">
				{primaryLinks.map(({ href, label }) => <a href={getLocalizedPath(href, locale)}>{label}</a>)}
			</nav>
			<nav class="site-footer__secondary" aria-label="Institutional navigation">
				{secondaryLinks.map(({ href, label }) => <a href={getLocalizedPath(href, locale)}>{label}</a>)}
				<nav class="site-footer__social" aria-label="Social media">
					<a class="social-facebook" href="https://www.facebook.com/padmapuraNL" target="_blank" rel="noopener noreferrer" aria-label="Padma Pura on Facebook">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M14 8h3V4h-3c-3.3 0-5 1.9-5 5v3H6v4h3v8h4v-8h3.5l.5-4H13V9c0-.7.3-1 1-1Z" /></svg>
					</a>
					<a class="social-youtube" href="https://www.youtube.com/@padmapura" target="_blank" rel="noopener noreferrer" aria-label="Padma Pura on YouTube">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" /></svg>
					</a>
				</nav>
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 8vw, 8rem) var(--space-8);
		margin-inline: auto;
		border-top: 2px solid var(--color-foreground);
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: minmax(13rem, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(var(--space-7), 8vw, 8rem);
		align-items: start;
	}

	.site-footer__identity {
		display: grid;
		grid-template-columns: auto auto;
		grid-template-rows: auto auto;
		column-gap: var(--space-5);
		row-gap: 0.5rem;
		align-items: center;
	}

	.site-footer__seal {
		display: block;
		flex: 0 0 auto;
		width: 5rem;
	}

	.site-footer__seal img {
		display: block;
		width: 100%;
		height: auto;
	}

	.site-footer__identity p {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2vw, 2.25rem);
		font-weight: 360;
		line-height: 1.1;
		font-optical-sizing: auto;
	}

	.site-footer__brand-copy {
		grid-column: 2;
		grid-row: 1;
	}

	.site-footer__navigation {
		display: grid;
		gap: var(--space-6);
		justify-items: start;
	}

	.site-footer__primary,
	.site-footer__secondary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.site-footer__primary {
		gap: var(--space-4) clamp(var(--space-5), 3vw, var(--space-7));
	}

	.site-footer__secondary {
		gap: var(--space-3) clamp(var(--space-5), 2.5vw, var(--space-6));
	}

	.site-footer a {
		font-family: var(--font-sans);
		text-decoration: none;
	}

	.site-footer__primary a {
		color: var(--color-foreground);
		font-size: var(--text-base);
		font-weight: 500;
		line-height: 1.4;
	}

	.site-footer__secondary a {
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 450;
		line-height: 1.4;
	}

	.site-footer__social a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		color: var(--color-muted);
		border: 1px solid var(--color-border);
		border-radius: 50%;
		text-decoration: none;
		transition: color 175ms ease, border-color 175ms ease;
	}

	.site-footer__social {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		justify-content: flex-start;
		flex: 0 0 auto;
		margin-left: calc(0.875rem - clamp(var(--space-5), 2.5vw, var(--space-6)));
	}

	.site-footer__social svg {
		display: block;
		width: 18px;
		height: 18px;
		fill: currentColor;
	}

	.site-footer a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.site-footer__social .social-facebook:hover,
	.site-footer__social .social-facebook:focus-visible {
		color: #1877f2;
		border-color: #1877f2;
		text-decoration: none;
	}

	.site-footer__social .social-youtube:hover,
	.site-footer__social .social-youtube:focus-visible {
		color: #ff0000;
		border-color: #ff0000;
		text-decoration: none;
	}

	@media (max-width: 48rem) {
		.site-footer {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-7);
		}

		.site-footer__inner {
			grid-template-columns: 1fr;
			gap: var(--space-7);
		}

		.site-footer__identity {
			justify-content: center;
			text-align: center;
			column-gap: var(--space-4);
		}

		.site-footer__seal {
			width: 4.75rem;
		}

		.site-footer__navigation {
			width: min(100%, 20rem);
			margin-inline: auto;
			gap: var(--space-6);
			justify-items: stretch;
		}

		.site-footer__primary,
		.site-footer__secondary {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			column-gap: var(--space-5);
			row-gap: var(--space-2);
			justify-items: start;
			text-align: left;
		}

		.site-footer__social {
			display: flex;
			align-items: center;
			justify-content: center;
			margin-left: 0;
		}

		.site-footer__primary {
			gap: var(--space-3);
		}

		.site-footer__secondary {
			gap: var(--space-2);
		}

		.site-footer__primary a,
		.site-footer__secondary a {
			display: flex;
			align-items: center;
			min-height: 2.75rem;
		}
	}
</style>