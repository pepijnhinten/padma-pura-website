		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-block: clamp(var(--space-7), 6vw, var(--space-8)) clamp(var(--space-8), 10vw, 8rem);
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
	}

	.support__introduction {
		margin-bottom: clamp(var(--space-8), 8vw, var(--space-9));
	}

	.photographic-intermezzo {
		width: 100%;
		padding-block: clamp(var(--space-6), 4vw, var(--space-7));
		background-color: var(--color-background);
	}

	.photographic-intermezzo__figure {
		width: calc(100% - (var(--space-6) * 2));
		max-width: clamp(50rem, 90%, var(--content-width));
		margin-inline: auto;
		margin-block: 0;
	}

	.photographic-intermezzo__image {
		display: block;
		width: 100%;
