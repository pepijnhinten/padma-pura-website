---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Members Portal | Padma Pura Foundation"
	description="Private members area of the Padma Pura Foundation for information, documents and materials for members."
>
	<section class="members-portal" aria-labelledby="members-portal-heading">
		<p class="members-portal__label">Padma Pura Foundation</p>
		<h1 id="members-portal-heading">Members Portal</h1>
		<div class="members-portal__content">
			<p class="members-portal__intro">A private area for members of the Padma Pura Foundation.</p>
			<p>Here you will find information, documents, teachings and other materials available specifically to members.</p>
			<p>The Members Portal is hosted in Microsoft 365 / SharePoint and opens in a separate secure environment.</p>
			<p class="members-portal__action"><a href="https://padmapurafoundation.sharepoint.com/sites/PadmaPuraMembers" target="_blank" rel="noopener noreferrer">Go to members area <span aria-hidden="true">→</span></a></p>
			<p class="members-portal__note">The members portal is only accessible to registered members.</p>
		</div>
	</section>
</BaseLayout>

<style>
	.members-portal {
		width: min(100% - (var(--space-6) * 2), var(--content-width-narrow));
		padding-block: clamp(var(--space-8), 12vw, 11rem) clamp(var(--space-9), 12vw, 12rem);
		margin-inline: auto;
	}

	.members-portal__label {
		margin: 0 0 var(--space-6);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.members-portal h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.25rem, 8vw, 5.5rem);
		font-weight: 380;
		line-height: 1;
	}

	.members-portal__content {
		max-width: 38rem;
		margin-top: clamp(var(--space-7), 6vw, var(--space-9));
	}

	.members-portal__content p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		line-height: 1.5;
	}

	.members-portal__content p + p {
		margin-top: var(--space-5);
	}

	.members-portal__intro {
		font-weight: 500;
	}

	.members-portal__action {
		margin-top: var(--space-7) !important;
	}

	.members-portal__action a {
		display: inline-flex;
		gap: var(--space-2);
		align-items: center;
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-accent);
		color: var(--color-accent);
		font-size: var(--text-base);
		font-weight: 600;
		text-decoration: none;
	}

	.members-portal__action a:hover {
		background: var(--color-accent);
		color: var(--color-background);
	}

	.members-portal__note {
		color: var(--color-muted);
		font-size: var(--text-sm) !important;
	}

	@media (max-width: 48rem) {
		.members-portal {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.members-portal h1 {
			font-size: clamp(2.75rem, 13vw, 4rem);
		}

		.members-portal__content {
			margin-top: var(--space-7);
		}
	}
</style>
