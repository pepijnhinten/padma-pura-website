---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/locale";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const details = [
	{ label: "Name", value: ["Padma Pura Foundation"] },
	{ label: "RSIN", value: ["861789659"] },
];
const copy = locale === "nl" ? {
	label: "Stichting", heading: "Stichting & ANBI", opening: ["Padma Pura Foundation is een Nederlandse stichting met ANBI-status. Zij ondersteunt de Dharma-activiteit van Tenzin Samphel Rinpoche in Nederland.", "Op deze pagina staan de formele informatie, het beleid en de documenten die door Padma Pura Foundation zijn gepubliceerd."], details: "Stichtingsgegevens", name: "Naam", address: "Adres", email: "E-mail",
	policyHeading: "Doelstelling & beleid", policy: ["Padma Pura Foundation ondersteunt de Dharma-activiteit van Tenzin Samphel Rinpoche in Nederland. De huidige activiteiten zijn vooral gericht op het scheppen van de praktische voorwaarden voor Rinpoche’s bezoeken, onderricht, inwijdingen, mondelinge overdrachten, beoefeningsinstructies en verwante Dharma-activiteiten.", "Met deze activiteiten wil de stichting studenten ondersteunen bij het ontwikkelen van compassie en een goed hart, en bij het ontwikkelen van begrip en vaardigheden waarmee zij zichzelf en anderen effectiever kunnen helpen.", "De doelstellingen van de stichting omvatten ook het ondersteunen van onderwijs voor kansarme kinderen en het bevorderen van de gezondheid en het welzijn van ouderen. Op dit moment zijn er op deze gebieden geen afzonderlijke projecten actief.", "De doelstellingen, activiteiten, het financieel beheer en het gebruik van middelen van de stichting worden beschreven in de beleidsdocumenten. Het gepubliceerde beleidsplan is beschikbaar in de documenten hieronder."],
	board: "Bestuur", remuneration: "Beloningsbeleid", boardText: ["Padma Pura Foundation wordt bestuurd door een klein bestuur dat verantwoordelijk is voor de formele administratie en het toezicht op de stichting.", "Tenzin Samphel Rinpoche — Voorzitter", "Pepijn Hinten White — Secretaris & Penningmeester"], remunerationText: "Bestuursleden ontvangen geen vergoeding voor hun bestuurstaken. Redelijke kosten die bij de uitvoering van deze taken worden gemaakt, kunnen overeenkomstig de toepasselijke regels worden vergoed.",
	activitiesReport: "Activiteitenverslag", activitiesText: ["Padma Pura Foundation publiceert verslagen over de activiteiten die door de stichting worden uitgevoerd. De huidige activiteiten zijn vooral gericht op het ondersteunen van de Dharma-activiteit van Tenzin Samphel Rinpoche in Nederland, waaronder bezoeken, onderricht en overdrachten, beoefeningsactiviteiten en verwant organisatorisch werk.", "Het meest recente gepubliceerde verslag is beschikbaar in de documenten hieronder."], financial: "Financiële verantwoording", financialText: ["Padma Pura Foundation publiceert haar financiële verantwoording overeenkomstig de vereisten voor ANBI-organisaties. De gepubliceerde financiële documenten geven informatie over de inkomsten, uitgaven, bezittingen en het gebruik van middelen van de stichting.", "De meest recente financiële verantwoording is beschikbaar in de documenten hieronder."], documents: "Documenten", documentsIntro: "Padma Pura Foundation publiceert jaarlijks informatie over haar activiteiten en financiële verantwoording als onderdeel van haar ANBI-transparantieverplichtingen. Voor 2023 en 2024 gebruikte de stichting het officiële ANBI-publicatieformulier om deze informatie te publiceren.", annual: "Jaarlijkse verslaglegging & financiële verantwoording", policyDocs: "Beleidsdocumenten", reports: ["Jaarverslag & financiële verantwoording 2025", "ANBI-publicatieformulier 2024", "ANBI-publicatieformulier 2023", "Jaarverslag & financiële verantwoording 2022", "Jaarverslag & financiële verantwoording 2021"], policyPlans: ["Beleidsplan 2025–2026", "Beleidsplan 2023–2024", "Beleidsplan 2021–2022"],
} : {
	label: "Foundation", heading: "Foundation & ANBI", opening: ["Padma Pura Foundation is a Dutch foundation with ANBI status. It supports the Dharma activity of Tenzin Samphel Rinpoche in the Netherlands.", "This page contains the formal information, policies and documents published by Padma Pura Foundation."], details: "Foundation details", name: "Name", address: "Address", email: "Email",
	policyHeading: "Purpose & policy", policy: ["Padma Pura Foundation supports the Dharma activity of Tenzin Samphel Rinpoche in the Netherlands. Its current activities focus on creating the practical conditions for Rinpoche’s visits, teachings, empowerments, oral transmissions, practice guidance and related Dharma activities.", "Through these activities, the foundation aims to support students in cultivating compassion and a good heart, while developing understanding and skills that can help themselves and others more effectively.", "The foundation’s objectives also include supporting education for underprivileged children and promoting the health and well-being of elderly people. No dedicated projects in these areas are currently active.", "The foundation’s objectives, activities, financial management and use of resources are described in its policy documents. The published policy plan is available in the Documents section below."],
	board: "Board", remuneration: "Remuneration policy", boardText: ["Padma Pura Foundation is governed by a small board responsible for the formal administration and oversight of the foundation.", "Tenzin Samphel Rinpoche — Chair", "Pepijn Hinten White — Secretary & Treasurer"], remunerationText: "Board members receive no remuneration for their board duties. Reasonable expenses incurred in the performance of those duties may be reimbursed in accordance with applicable rules.",
	activitiesReport: "Activities report", activitiesText: ["Padma Pura Foundation publishes reports on the activities carried out by the foundation. Its current activities are primarily focused on supporting Tenzin Samphel Rinpoche’s Dharma activity in the Netherlands, including visits, teachings and transmissions, practice activities and related organisational work.", "The latest published report is available in the Documents section below."], financial: "Financial accountability", financialText: ["Padma Pura Foundation publishes its financial accountability in accordance with the requirements for ANBI organisations. The published financial documents provide information about the foundation’s income, expenditure, assets and use of resources.", "The latest published financial accountability is available in the Documents section below."], documents: "Documents", documentsIntro: "Padma Pura Foundation publishes annual information about its activities and financial accountability as part of its ANBI transparency obligations. For 2023 and 2024, the foundation used the official ANBI publication form to publish this information.", annual: "Annual reporting & financial accountability", policyDocs: "Policy documents", reports: ["Annual report & financial accountability 2025", "ANBI publication form 2024", "ANBI publication form 2023", "Annual report & financial accountability 2022", "Annual report & financial accountability 2021"], policyPlans: ["Policy plan 2025–2026", "Policy plan 2023–2024", "Policy plan 2021–2022"],
};
const reportPaths = ["/documents/anbi/annual-report-financial-accountability-2025.pdf", "/documents/anbi/anbi-publication-form-2024.pdf", "/documents/anbi/anbi-publication-form-2023.pdf", "/documents/anbi/annual-report-2022.pdf", "/documents/anbi/annual-report-2021.pdf"];
const policyPlanPaths = ["/documents/beleidsplan-2025-2026-padma-pura.pdf", "/documents/anbi/policy-plan-2023-2024.pdf", "/documents/anbi/policy-plan-2021-2022.pdf"];
---

<BaseLayout title="Foundation & ANBI | Padma Pura Foundation" description="Formal information, policies and financial documents published by Padma Pura Foundation.">
	<section class="foundation-opening" aria-labelledby="foundation-heading">
		<p class="foundation-opening__label">{copy.label}</p>
		<h1 id="foundation-heading">{copy.heading}</h1>
		<div class="foundation-opening__intro">{copy.opening.map((paragraph) => <p>{paragraph}</p>)}</div>
	</section>

	<section class="details" aria-labelledby="details-heading">
		<h2 id="details-heading">{copy.details}</h2>
		<dl class="details__list">
			{details.map(({ label, value }) => <div class="details__row"><dt>{label === "Name" ? copy.name : label === "Address" ? copy.address : label}</dt><dd>{value.map((line) => <span class="details__line">{line}</span>)}</dd></div>)}
			<div class="details__row"><dt>{copy.email}</dt><dd><a href="mailto:info@padmapura.com">info@padmapura.com</a></dd></div>
		</dl>
		<img class="details__anbi-mark" src="/images/foundation/anbi-status.png" alt="ANBI — Algemeen Nut Beogende Instelling" />
	</section>

	<section class="policy" aria-labelledby="policy-heading">
		<h2 id="policy-heading">{copy.policyHeading}</h2>
		<div class="policy__prose">{copy.policy.map((paragraph) => <p>{paragraph}</p>)}</div>
	</section>

	<section class="governance" aria-label="Board and remuneration policy">
		<div class="governance__col"><h2 id="board-heading">{copy.board}</h2><div class="governance__prose">{copy.boardText.map((paragraph) => <p>{paragraph}</p>)}</div></div>
		<div class="governance__col"><h2 id="remuneration-heading">{copy.remuneration}</h2><div class="governance__prose"><p>{copy.remunerationText}</p></div></div>
	</section>

	<section class="publications" aria-label="Activities report and financial accountability">
		<div class="publications__row"><h2 id="activities-report-heading">{copy.activitiesReport}</h2><div class="publications__prose">{copy.activitiesText.map((paragraph) => <p>{paragraph}</p>)}</div></div>
		<div class="publications__row"><h2 id="financial-accountability-heading">{copy.financial}</h2><div class="publications__prose">{copy.financialText.map((paragraph) => <p>{paragraph}</p>)}</div></div>
		<div class="publications__row">
			<h2 id="documents-heading">{copy.documents}</h2>
			<div class="publications__prose documents-list__intro"><p>{copy.documentsIntro}</p></div>
			<div class="documents-list">
				<div class="documents-list__group"><h3>{copy.annual}</h3><ul>{copy.reports.map((report, index) => <li><a href={reportPaths[index]}>{report} <span>(PDF)</span></a></li>)}</ul></div>
				<div class="documents-list__group"><h3>{copy.policyDocs}</h3><ul>{copy.policyPlans.map((policyPlan, index) => <li><a href={policyPlanPaths[index]}>{policyPlan} <span>(PDF)</span></a></li>)}</ul></div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.foundation-opening { width: min(100% - (var(--space-6) * 2), var(--content-width)); padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-7), 8vw, 8rem); margin-inline: auto; }
	.foundation-opening__label { margin: 0 0 var(--space-6); color: var(--color-muted); font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 500; letter-spacing: 0.02em; line-height: 1.4; }
	.foundation-opening h1 { max-width: 16ch; margin: 0; font-family: var(--font-display); font-size: clamp(3.25rem, 6vw, 5.5rem); font-weight: 380; letter-spacing: 0; line-height: 1; font-optical-sizing: auto; }
	.foundation-opening__intro { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--space-6), 5vw, var(--space-8)); max-width: none; margin-top: clamp(var(--space-7), 6vw, var(--space-9)); }
	.foundation-opening__intro p { margin: 0; font-family: var(--font-sans); font-size: var(--text-lg); font-weight: 400; line-height: 1.5; }
	.foundation-opening__intro p + p { margin-top: 0; }
	.details { display: grid; grid-template-columns: minmax(0, 1fr) 180px; column-gap: clamp(var(--space-7), 8vw, var(--space-9)); width: min(100% - (var(--space-6) * 2), var(--content-width)); padding-bottom: clamp(var(--space-8), 8vw, 7.5rem); margin-inline: auto; }
	.details h2 { width: min(100%, var(--content-width-narrow)); margin: 0 0 var(--space-7); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 360; line-height: 1.05; font-optical-sizing: auto; }
	.details__list { max-width: 42rem; margin: 0; border-top: 1px solid var(--color-border); }
	.details__row { display: grid; grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr); gap: var(--space-5); align-items: baseline; padding-block: var(--space-5); border-bottom: 1px solid var(--color-border); }
	.details__row dt, .details__row dd { margin: 0; font-family: var(--font-sans); line-height: 1.4; }
	.details__row dt { color: var(--color-muted); font-size: var(--text-sm); font-weight: 500; letter-spacing: 0.02em; }
	.details__row dd { display: flex; flex-direction: column; font-size: var(--text-base); font-weight: 400; }
	.details__anbi-mark { display: block; width: 180px; height: auto; grid-column: 2; grid-row: 1 / span 2; align-self: center; margin: 0; }
	.policy { width: min(100% - (var(--space-6) * 2), var(--content-width)); padding-bottom: clamp(var(--space-8), 8vw, 7.5rem); margin-inline: auto; }
	.policy h2 { max-width: none; margin: 0 0 var(--space-6); font-family: var(--font-display); font-size: clamp(2.5rem, 3.5vw, 3rem); font-weight: 370; line-height: 1.05; font-optical-sizing: auto; }
	.policy__prose { max-width: 42rem; }
	.policy__prose p { margin: 0; font-family: var(--font-sans); font-size: var(--text-base); font-weight: 400; line-height: 1.6; }
	.policy__prose p + p { margin-top: var(--space-6); }
	.governance { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(var(--space-6), 6vw, var(--space-8)); width: min(100% - (var(--space-6) * 2), var(--content-width)); padding-bottom: clamp(var(--space-7), 7vw, 7rem); margin-inline: auto; }
	.governance h2 { margin: 0 0 var(--space-5); font-family: var(--font-display); font-size: var(--text-lg); font-weight: 380; line-height: 1.1; font-optical-sizing: auto; }
	.governance__prose { max-width: 30rem; }
	.governance__prose p { margin: 0; font-family: var(--font-sans); font-size: var(--text-base); font-weight: 400; line-height: 1.6; }
	.governance__prose p + p { margin-top: var(--space-4); }
	.publications { width: min(100% - (var(--space-6) * 2), var(--content-width)); padding-bottom: clamp(var(--space-8), 8vw, 7.5rem); margin-inline: auto; border-top: 1px solid var(--color-border); }
	.publications__row { max-width: 48rem; padding-block: var(--space-7); border-bottom: 1px solid var(--color-border); }
	.publications h2 { margin: 0 0 var(--space-5); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 360; line-height: 1.05; font-optical-sizing: auto; }
	.publications__prose p { margin: 0; font-family: var(--font-sans); font-size: var(--text-base); font-weight: 400; line-height: 1.6; }
	.publications__prose p + p { margin-top: var(--space-5); }
	.documents-list__group + .documents-list__group { margin-top: var(--space-7); }
	.documents-list h3 { margin: 0 0 var(--space-3); color: var(--color-muted); font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 500; letter-spacing: 0.02em; line-height: 1.4; }
	.documents-list ul { margin: 0; padding: 0; border-top: 1px solid var(--color-border); list-style: none; }
	.documents-list li { padding-block: var(--space-4); border-bottom: 1px solid var(--color-border); font-family: var(--font-sans); font-size: var(--text-base); line-height: 1.4; }
	.documents-list a { display: inline-flex; gap: var(--space-2); align-items: baseline; }
	.documents-list a span { color: var(--color-muted); font-size: var(--text-sm); white-space: nowrap; }
	@media (max-width: 48rem) {
		.foundation-opening { width: calc(100% - (var(--space-5) * 2)); padding-block: var(--space-8) var(--space-9); }
		.foundation-opening h1 { max-width: none; font-size: clamp(2.5rem, 11vw, 3.5rem); line-height: 1.02; }
		.foundation-opening__intro { display: block; max-width: none; margin-top: var(--space-7); }
		.foundation-opening__intro p { font-size: var(--text-base); }
		.foundation-opening__intro p + p { margin-top: var(--space-5); }
		.details { display: block; width: calc(100% - (var(--space-5) * 2)); padding-bottom: var(--space-9); }
		.details h2 { width: 100%; margin: 0 0 var(--space-6); }
		.details__list { max-width: none; }
		.details__anbi-mark { width: 150px; margin: var(--space-6) 0 0; }
		.details__row { display: block; padding-block: var(--space-5); }
		.details__row dt { margin-bottom: var(--space-2); }
		.policy { width: calc(100% - (var(--space-5) * 2)); padding-bottom: var(--space-9); }
		.documents-list { margin-top: var(--space-5); }
		.policy h2 { max-width: none; margin: 0 0 var(--space-6); font-size: clamp(2rem, 8vw, 2.5rem); }
		.policy__prose { max-width: none; margin-left: 0; }
		.governance { display: block; width: calc(100% - (var(--space-5) * 2)); padding-bottom: var(--space-9); }
		.governance__col + .governance__col { margin-top: var(--space-7); }
		.governance__prose { max-width: none; }
		.publications { width: calc(100% - (var(--space-5) * 2)); padding-bottom: var(--space-9); }
		.publications__row { max-width: none; padding-block: var(--space-6); }
	}
</style>
