---
const primaryLinks = [
	{ href: "/our-teacher", label: "Our Teacher" },
	{ href: "/lineage", label: "Lineage" },
	{ href: "/activities", label: "Activities" },
	{ href: "/padma-pura", label: "Padma Pura" },
	{ href: "/support", label: "Support" },
];

const secondaryLinks = [
	{ href: "/foundation-anbi", label: "Foundation & ANBI" },
	{ href: "/contact", label: "Contact" },
	{ href: "/privacy", label: "Privacy" },
];
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__identity">
			<a class="site-footer__seal" href="/" aria-label="Padma Pura home">
				<img src="/brand/padma-pura-seal.png" alt="Padma Pura seal" />
			</a>
			<p>Padma Pura</p>
		</div>

		<div class="site-footer__navigation">
			<nav class="site-footer__primary" aria-label="Primary footer navigation">
				{primaryLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
			</nav>
			<nav class="site-footer__secondary" aria-label="Institutional navigation">
				{secondaryLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 8vw, 8rem) var(--space-8);
		margin-inline: auto;
		border-top: 2px solid var(--color-foreground);
	}

	.site-footer__inner {
		display: grid;
		grid-template-columns: minmax(13rem, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(var(--space-7), 8vw, 8rem);
		align-items: start;
	}

	.site-footer__identity {
		display: flex;
		gap: var(--space-5);
		align-items: center;
	}

	.site-footer__seal {
		display: block;
		flex: 0 0 auto;
		width: 5rem;
		padding: var(--space-2);
		background: #ffffff;
	}

	.site-footer__seal img {
		display: block;
		width: 100%;
		height: auto;
	}

	.site-footer__identity p {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2vw, 2.25rem);
		font-weight: 360;
		line-height: 1.1;
		font-optical-sizing: auto;
	}

	.site-footer__navigation {
		display: grid;
		gap: var(--space-7);
		justify-items: start;
	}

	.site-footer__primary,
	.site-footer__secondary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}

	.site-footer__primary {
		gap: var(--space-4) clamp(var(--space-5), 3vw, var(--space-7));
	}

	.site-footer__secondary {
		gap: var(--space-3) clamp(var(--space-5), 2.5vw, var(--space-6));
	}

	.site-footer a {
		font-family: var(--font-sans);
		text-decoration: none;
	}

	.site-footer__primary a {
		color: var(--color-foreground);
		font-size: var(--text-base);
		font-weight: 500;
		line-height: 1.4;
	}

	.site-footer__secondary a {
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 450;
		line-height: 1.4;
	}

	.site-footer a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	@media (max-width: 48rem) {
		.site-footer {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-7);
		}

		.site-footer__inner {
			grid-template-columns: 1fr;
			gap: var(--space-7);
		}

		.site-footer__seal {
			width: 4.75rem;
			padding: var(--space-1);
		}

		.site-footer__navigation {
			gap: var(--space-6);
		}

		.site-footer__primary,
		.site-footer__secondary {
			display: grid;
			justify-items: start;
		}

		.site-footer__primary {
			gap: var(--space-3);
		}

		.site-footer__secondary {
			gap: var(--space-2);
		}

		.site-footer__primary a,
		.site-footer__secondary a {
			display: flex;
			align-items: center;
			min-height: 2.75rem;
		}
	}
</style>