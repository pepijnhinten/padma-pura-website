---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const activities = await getCollection(
		"activities",
		({ data }) => data.publicationStatus === "published",
	);

	return activities.map((activity) => ({
		params: { slug: activity.id },
		props: { activity },
	}));
}

interface Props {
	activity: CollectionEntry<"activities">;
}

const { activity } = Astro.props;
const { Content } = await render(activity);
const {
	title,
	summary,
	activityType,
	startDate,
	endDate,
	location,
	practicalInformation,
	events,
} = activity.data;

const activityTypeLabels = {
	"rinpoche-visit": "Rinpoche visit",
	tsog: "Tsog",
	tsetar: "Tsetar",
	gutor: "Gutor",
	other: "Other",
};

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: "UTC",
});

const formatDate = (date: Date) => dateFormatter.format(date);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const hasDetails = startDate || endDate || location || practicalInformation;
---

<BaseLayout
	title={`${title} — Padma Pura Foundation`}
	description={summary}
>
	<article class="activity">
		<header class="activity__header">
			<p class="activity__type">{activityTypeLabels[activityType]}</p>
			<h1>{title}</h1>
			<p class="activity__summary">{summary}</p>
		</header>

		{hasDetails && (
			<dl class="activity__details">
				{startDate && (
					<div>
						<dt>{endDate ? "Dates" : "Date"}</dt>
						<dd>
							<time datetime={isoDate(startDate)}>{formatDate(startDate)}</time>
							{endDate && (
								<> – <time datetime={isoDate(endDate)}>{formatDate(endDate)}</time></>
							)}
						</dd>
					</div>
				)}
				{!startDate && endDate && (
					<div>
						<dt>End date</dt>
						<dd><time datetime={isoDate(endDate)}>{formatDate(endDate)}</time></dd>
					</div>
				)}
				{location && (
					<div>
						<dt>Location</dt>
						<dd>{location}</dd>
					</div>
				)}
				{practicalInformation && (
					<div>
						<dt>Practical information</dt>
						<dd>{practicalInformation}</dd>
					</div>
				)}
			</dl>
		)}

		{activity.body && (
			<div class="activity__body">
				<Content />
			</div>
		)}

		{events && events.length > 0 && (
			<section class="programme" aria-labelledby="programme-heading">
				<h2 id="programme-heading">Programme</h2>
				<ol class="programme__list">
					{events.map((event) => (
						<li class="programme__event">
							<h3>{event.title}</h3>
							{(event.date || event.startTime || event.endTime || event.location) && (
								<p class="programme__details">
									{event.date && <time datetime={isoDate(event.date)}>{formatDate(event.date)}</time>}
									{event.date && (event.startTime || event.endTime) && <span aria-hidden="true"> · </span>}
									{event.startTime && <time datetime={event.startTime}>{event.startTime}</time>}
									{event.startTime && event.endTime && <span aria-hidden="true">–</span>}
									{event.endTime && <time datetime={event.endTime}>{event.endTime}</time>}
									{(event.date || event.startTime || event.endTime) && event.location && <span aria-hidden="true"> · </span>}
									{event.location && <span>{event.location}</span>}
								</p>
							)}
							{event.practicalNote && <p class="programme__note">{event.practicalNote}</p>}
						</li>
					))}
				</ol>
			</section>
		)}
	</article>
</BaseLayout>

<style>
	.activity {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 8rem);
		margin-inline: auto;
	}

	.activity__header,
	.activity__details,
	.activity__body,
	.programme {
		max-width: var(--content-width-narrow);
	}

	.activity__type {
		margin: 0 0 var(--space-5);
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 500;
	}

	.activity h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3rem, 6vw, 5.25rem);
		font-optical-sizing: auto;
		font-weight: 380;
		line-height: 1;
	}

	.activity__summary {
		margin: var(--space-7) 0 0;
		font-size: var(--text-lg);
		line-height: 1.5;
	}

	.activity__details {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-5) var(--space-7);
		margin-block: var(--space-8);
		padding-block: var(--space-6);
		border-block: 1px solid var(--color-border);
	}

	.activity__details div {
		min-width: 0;
	}

	.activity__details dt {
		margin-bottom: var(--space-1);
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 500;
	}

	.activity__details dd {
		margin: 0;
		white-space: pre-line;
	}

	.activity__body {
		margin-top: var(--space-8);
	}

	.activity__body :global(h2) {
		margin: var(--space-8) 0 var(--space-5);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-optical-sizing: auto;
		font-weight: 380;
		line-height: 1.1;
	}

	.activity__body :global(h3) {
		margin: var(--space-7) 0 var(--space-4);
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 430;
		line-height: 1.2;
	}

	.activity__body :global(p),
	.activity__body :global(ul),
	.activity__body :global(ol) {
		margin-block: 0 var(--space-5);
	}

	.programme {
		margin-top: var(--space-9);
	}

	.programme h2 {
		margin: 0 0 var(--space-7);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-optical-sizing: auto;
		font-weight: 380;
		line-height: 1.1;
	}

	.programme__list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.programme__event {
		padding-block: var(--space-6);
		border-bottom: 1px solid var(--color-border);
	}

	.programme__event h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 430;
		line-height: 1.25;
	}

	.programme__details,
	.programme__note {
		margin: var(--space-3) 0 0;
	}

	.programme__details {
		color: var(--color-muted);
		font-size: var(--text-sm);
	}

	.programme__details time + time {
		margin-left: var(--space-1);
	}

	@media (max-width: 40rem) {
		.activity {
			width: min(100% - (var(--space-5) * 2), var(--content-width));
		}

		.activity__details {
			grid-template-columns: 1fr;
		}
	}
</style>