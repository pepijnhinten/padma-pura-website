---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedPath, type Locale } from "../lib/locale";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const copy = locale === "nl" ? {
	label: "Lineage", heading: "Lineage & overdracht", intro: "Tenzin Samphel Rinpoche geeft onderricht binnen de Nyingma-traditie van het Tibetaans boeddhisme. Hij houdt verschillende overdrachtslijnen en beoefeningscycli binnen deze traditie en draagt deze over.",
	traditionHeading: "De Nyingma-traditie", tradition: ["Nyingma is de oudste van de belangrijkste tradities van het Tibetaans boeddhisme. Door de eeuwen heen zijn de onderrichtingen en beoefeningen ervan bewaard gebleven en via talrijke overdrachtslijnen en beoefeningscycli overgedragen.", "De Nyingma-traditie omvat zowel lang bestaande overdrachtslijnen als terma-tradities — onthulde onderrichtingen en beoefeningscycli die een belangrijk onderdeel van haar erfgoed vormen."],
	trainingHeading: "Rinpoche’s opleiding en overdracht", training: ["Tenzin Samphel Rinpoche ontving onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies van meesters onder wie Kyabjé Dudjom Rinpoche, Dilgo Khyentse Rinpoche, Chadral Rinpoche en Khetsun Sangpo Rinpoche.", "Hij houdt meerdere overdrachtslijnen en beoefeningscycli binnen de Nyingma-traditie en draagt deze over. In 1999 benoemde Khetsun Sangpo Rinpoche hem tot lineagehouder en vertrouwde hem de spirituele verantwoordelijkheid over Shedup Kunsang Chöling toe."],
	tersar: ["Dudjom Tersar is een terma-traditie binnen de Nyingma-school van het Tibetaans boeddhisme, verbonden met Dudjom Lingpa en Dudjom Rinpoche, Jigdral Yeshe Dorje. Het is geen afzonderlijke school, maar een geheel van onderrichtingen en beoefeningscycli die binnen de bredere Nyingma-traditie worden overgedragen.", "Dudjom Tersar neemt een centrale plaats in binnen veel van de beoefeningen, inwijdingen, mondelinge overdrachten en het onderricht dat Tenzin Samphel Rinpoche geeft via activiteiten van Padma Pura Foundation."],
	yangti: "Rinpoche houdt ook overdrachtslijnen van Yangti Nagpo, een Dzogchen-terma-cyclus binnen de Nyingma-traditie, en van Longchen Nyingthig, de terma-traditie die door Jigme Lingpa is onthuld.",
	livingHeading: "Levende overdracht", living: ["Door zijn Dharma-activiteit blijft Tenzin Samphel Rinpoche de onderrichtingen en beoefeningscycli die hij heeft ontvangen en beoefend overdragen, door middel van onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies.", "Padma Pura Foundation ondersteunt deze activiteit in Nederland en helpt de praktische voorwaarden te scheppen voor Rinpoche’s bezoeken en voor studenten om zijn begeleiding te ontvangen en samen te beoefenen."],
	captionKhetsun: "Khetsun Sangpo Rinpoche", captionDudjom: "Dudjom Lingpa", captionRinpoche: "Kyabjé Dudjom Rinpoche",
	imageAltKhetsun: "Khetsun Sangpo Rinpoche", imageAltDudjom: "Dudjom Lingpa", imageAltRinpoche: "Kyabjé Dudjom Rinpoche",
	tersarHeading: "Dudjom Tersar", yangtiHeading: "Yangti Nagpo en Longchen Nyingthig",
} : {
	label: "Lineage", heading: "Lineage & Transmission", intro: "Tenzin Samphel Rinpoche teaches within the Nyingma tradition of Tibetan Buddhism. He holds and transmits several transmission lineages and practice cycles within that tradition.",
	traditionHeading: "The Nyingma tradition", tradition: ["Nyingma is the oldest of the major traditions of Tibetan Buddhism. Over many centuries, its teachings and practices have been preserved and transmitted through numerous lineages and practice cycles.", "The Nyingma tradition includes both long-established transmission lineages and terma traditions — revealed teachings and practice cycles that form an important part of its heritage."],
	trainingHeading: "Rinpoche's training and transmission", training: ["Tenzin Samphel Rinpoche received teachings, empowerments, oral transmissions and practice instructions from masters including Kyabjé Dudjom Rinpoche, Dilgo Khyentse Rinpoche, Chadral Rinpoche and Khetsun Sangpo Rinpoche.", "He holds and transmits multiple transmission lineages and practice cycles within the Nyingma tradition. In 1999, Khetsun Sangpo Rinpoche enthroned him as a lineage holder and entrusted him with spiritual authority at Shedup Kunsang Chöling."],
	tersar: ["Dudjom Tersar is a terma tradition within the Nyingma school of Tibetan Buddhism, associated with Dudjom Lingpa and Dudjom Rinpoche, Jigdral Yeshe Dorje. It is not a separate school, but a body of teachings and practice cycles transmitted within the wider Nyingma tradition.", "Dudjom Tersar has a central place in many of the practices, empowerments, oral transmissions and teachings that Tenzin Samphel Rinpoche gives through Padma Pura Foundation activities."],
	yangti: "Rinpoche also holds transmission lineages of Yangti Nagpo, a Dzogchen terma cycle within the Nyingma tradition, and Longchen Nyingthig, the terma tradition revealed by Jigme Lingpa.",
	livingHeading: "Living transmission", living: ["Through his Dharma activity, Tenzin Samphel Rinpoche continues to transmit the teachings and practice cycles he has received and practised, through teachings, empowerments, oral transmissions and practice guidance.", "Padma Pura Foundation supports this activity in the Netherlands, helping create the practical conditions for Rinpoche's visits and for students to receive his guidance and practise together."],
	captionKhetsun: "Khetsun Sangpo Rinpoche", captionDudjom: "Dudjom Lingpa", captionRinpoche: "Kyabjé Dudjom Rinpoche",
	imageAltKhetsun: "Khetsun Sangpo Rinpoche", imageAltDudjom: "Dudjom Lingpa", imageAltRinpoche: "Kyabjé Dudjom Rinpoche",
	tersarHeading: "Dudjom Tersar", yangtiHeading: "Yangti Nagpo and Longchen Nyingthig",
};
const localizedPath = (path: string) => getLocalizedPath(path, locale);
---

<BaseLayout
	title="Lineage & Transmission | Padma Pura Foundation"
	description="The Nyingma tradition and the transmission lineages and practice cycles held by Tenzin Samphel Rinpoche, taught through Padma Pura Foundation."
>
	<section class="lineage-opening" aria-labelledby="lineage-heading">
		<p class="lineage-opening__label">{copy.label}</p>
		<h1 id="lineage-heading">{copy.heading}</h1>
		<p class="lineage-opening__intro">{copy.intro}</p>
	</section>

	<section class="nyingma" aria-labelledby="nyingma-heading">
		<h2 id="nyingma-heading">{copy.traditionHeading}</h2>
		<div class="nyingma__prose">
			{copy.tradition.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>



	<section class="rinpoche-transmission" aria-labelledby="rinpoche-transmission-heading">
		<h2 id="rinpoche-transmission-heading">{copy.trainingHeading}</h2>
		<div class="rinpoche-transmission__prose">
			{copy.training.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<figure class="lineage__contextual-media">
			<img src="/images/lineage/khetsun-sangpo-rinpoche.jpg" alt="Khetsun Sangpo Rinpoche" />
			<figcaption>{copy.captionKhetsun}</figcaption>
		</figure>
	</section>

	<section class="dudjom-tersar" aria-labelledby="dudjom-tersar-heading">
		<h2 id="dudjom-tersar-heading">{copy.tersarHeading}</h2>
		<div class="dudjom-tersar__prose">
			{copy.tersar.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<div class="lineage__portrait-pair">
			<figure>
				<img src="/images/lineage/Dudjom_Lingpa.jpg" alt="Dudjom Lingpa" />
				<figcaption>{copy.captionDudjom}</figcaption>
			</figure>
			<figure>
				<img src="/images/lineage/dudjom-rinpoche.webp" alt="Kyabjé Dudjom Rinpoche" />
				<figcaption>{copy.captionRinpoche}</figcaption>
			</figure>
		</div>
	</section>

	<section class="yangti-nagpo" aria-labelledby="yangti-nagpo-heading">
		<h2 id="yangti-nagpo-heading">{copy.yangtiHeading}</h2>
		<div class="yangti-nagpo__prose">
			<p>{copy.yangti}</p>
		</div>
	</section>

	<section class="living-transmission" aria-labelledby="living-transmission-heading">
		<h2 id="living-transmission-heading">{copy.livingHeading}</h2>
		<div class="living-transmission__prose">
			{copy.living.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>
</BaseLayout>

<style>
	.lineage-opening {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-8), 8vw, 7.5rem);
		margin-inline: auto;
	}

	.lineage-opening__label {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.lineage-opening h1 {
		max-width: 16ch;
		margin: var(--space-6) 0 0;
		font-family: var(--font-display);
		font-size: clamp(3rem, 5.5vw, 5.5rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 1.02;
		font-optical-sizing: auto;
	}

	.lineage-opening__intro {
		max-width: 42rem;
		margin: clamp(var(--space-5), 3vw, var(--space-7)) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.nyingma {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.nyingma h2,
	.nyingma p {
		margin: 0;
	}

	.nyingma h2 {
		margin-bottom: var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.nyingma__prose {
		max-width: 42rem;
	}

	.nyingma p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.nyingma p + p {
		margin-top: var(--space-6);
	}

	.rinpoche-transmission {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.rinpoche-transmission h2,
	.rinpoche-transmission p {
		margin: 0;
	}

	.rinpoche-transmission h2 {
		margin-bottom: var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.rinpoche-transmission__prose {
		max-width: 42rem;
	}

	.rinpoche-transmission p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.rinpoche-transmission p + p {
		margin-top: var(--space-6);
	}

	.lineage__contextual-media {
		display: block;
		width: 40%;
		max-width: 20rem;
		height: auto;
		margin-top: clamp(var(--space-6), 4vw, var(--space-7));
	}

	.lineage__contextual-media img,
	.lineage__portrait-pair img {
		display: block;
		width: 100%;
		height: auto;
	}

	.lineage__contextual-media,
	.lineage__portrait-pair figure {
		margin-inline: 0;
		margin-bottom: 0;
	}

	.lineage__contextual-media figcaption,
	.lineage__portrait-pair figcaption {
		margin-top: var(--space-2);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.4;
		text-align: left;
	}

	.lineage__portrait-pair {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(var(--space-4), 3vw, var(--space-6));
		width: 80%;
		max-width: 40rem;
		margin-top: clamp(var(--space-6), 4vw, var(--space-7));
	}

	.dudjom-tersar {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.dudjom-tersar h2 {
		max-width: 20ch;
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(3rem, 4vw, 3.5rem);
		font-weight: 380;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.dudjom-tersar__prose {
		max-width: 44rem;
	}

	.dudjom-tersar__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.dudjom-tersar__prose p + p {
		margin-top: var(--space-6);
	}

	.dudjom-tersar__note {
		max-width: 44rem;
		margin: var(--space-7) 0 0 clamp(1.5rem, 6vw, 5rem);
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.yangti-nagpo {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.yangti-nagpo h2 {
		max-width: 20ch;
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(3rem, 4vw, 3.5rem);
		font-weight: 380;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.yangti-nagpo__prose {
		max-width: 44rem;
	}

	.yangti-nagpo__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.yangti-nagpo__prose p + p {
		margin-top: var(--space-6);
	}

	.living-transmission {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 6vw, var(--space-8));
		margin-inline: auto;
	}

	.living-transmission h2 {
		margin: 0 0 var(--space-7);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.living-transmission__prose {
		max-width: 42rem;
	}

	.living-transmission__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.living-transmission__prose p + p {
		margin-top: var(--space-6);
	}

	@media (max-width: 48rem) {
		.lineage-opening {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.lineage-opening h1 {
			max-width: none;
			margin: var(--space-5) 0 0;
			font-size: clamp(2.5rem, 11vw, 3.5rem);
			line-height: 1.05;
		}

		.lineage-opening__intro {
			max-width: none;
			margin: var(--space-6) 0 0;
			font-size: var(--text-base);
		}

		.nyingma {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.nyingma h2 {
			padding: 0 0 var(--space-6);
		}

		.nyingma p {
			font-size: var(--text-base);
		}

		.rinpoche-transmission {
			display: flex;
			flex-direction: column;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.rinpoche-transmission h2 {
			padding: 0;
		}

		.rinpoche-transmission p {
			font-size: var(--text-base);
		}

		.dudjom-tersar {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.dudjom-tersar h2 {
			max-width: none;
			margin: 0 0 var(--space-6);
			font-size: clamp(2.25rem, 9vw, 2.75rem);
		}

		.dudjom-tersar__prose {
			max-width: none;
			margin-left: 0;
		}

		.lineage__contextual-media {
			width: 76%;
			max-width: 18rem;
			margin: var(--space-7) auto 0;
		}

		.lineage__portrait-pair {
			display: block;
			width: 76%;
			max-width: 18rem;
			margin: var(--space-7) auto 0;
		}

		.lineage__portrait-pair figure + figure {
			margin-top: var(--space-6);
		}

		.dudjom-tersar__prose p {
			font-size: var(--text-base);
		}

		.dudjom-tersar__note {
			max-width: none;
			margin: var(--space-6) 0 0;
		}

		.yangti-nagpo {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.yangti-nagpo h2 {
			max-width: none;
			margin: 0 0 var(--space-6);
			font-size: clamp(2.25rem, 9vw, 2.75rem);
		}

		.yangti-nagpo__prose {
			max-width: none;
			margin-left: 0;
		}

		.yangti-nagpo__prose p {
			font-size: var(--text-base);
		}

		.living-transmission {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-7);
		}

		.living-transmission h2 {
			padding: 0 0 var(--space-6);
		}

		.living-transmission__prose p {
			font-size: var(--text-base);
		}
	}
</style>
