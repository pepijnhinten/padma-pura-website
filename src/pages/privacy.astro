---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/locale";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const copy = locale === "nl" ? {
	intro: "Padma Pura Foundation respecteert uw privacy en gaat zorgvuldig om met persoonsgegevens.",
	blocks: [
		{ heading: "Gegevens die we ontvangen", paragraphs: ["Wanneer u per e-mail contact opneemt met Padma Pura Foundation, ontvangen we de informatie die u kiest te verstrekken, zoals uw naam, e-mailadres en de inhoud van uw bericht.", "Informatie kan ook worden verstrekt wanneer u zich aanmeldt voor activiteiten, een jaarlijkse bijdrage gaat leveren of op andere wijze met de stichting correspondeert."] },
		{ heading: "Hoe we gegevens gebruiken", paragraphs: ["Persoonsgegevens worden alleen gebruikt waar dat nodig is voor de administratie van Padma Pura Foundation en haar activiteiten. Dit kan onder meer betekenen: reageren op vragen, activiteiten organiseren, praktische informatie delen en de ondersteuning van de stichting administreren.", "Persoonsgegevens worden niet verkocht en niet gebruikt voor commerciële reclame."] },
		{ heading: "Delen en bewaren", paragraphs: ["Persoonsgegevens worden alleen gedeeld waar dat nodig is voor het werk van Padma Pura Foundation of wanneer dit wettelijk verplicht is.", "Gegevens worden alleen bewaard zolang dat redelijkerwijs nodig is voor het doel waarvoor ze zijn verzameld en voor eventuele toepasselijke administratieve of wettelijke verplichtingen."] },
		{ heading: "Uw rechten", paragraphs: ["Op grond van toepasselijke wetgeving inzake gegevensbescherming kunt u rechten hebben met betrekking tot uw persoonsgegevens, waaronder het recht om toegang, correctie of verwijdering te vragen.", "Voor vragen of verzoeken over uw persoonsgegevens kunt u contact opnemen:"] },
		{ heading: "Websitetechnologie", paragraphs: ["Deze website gebruikt momenteel geen analytics, advertentietrackers of marketingcookies."] },
	],
} : {
	intro: "Padma Pura Foundation respects your privacy and handles personal information with care.",
	blocks: [
		{ heading: "Information we receive", paragraphs: ["When you contact Padma Pura Foundation by email, we receive the information you choose to provide, such as your name, email address and the contents of your message.", "Information may also be provided when you register for activities, become an annual supporter or otherwise correspond with the foundation."] },
		{ heading: "How we use information", paragraphs: ["Personal information is used only where necessary for the administration of Padma Pura Foundation and its activities. This may include responding to enquiries, organising activities, communicating practical information and administering support for the foundation.", "Personal information is not sold or used for commercial advertising."] },
		{ heading: "Sharing and retention", paragraphs: ["Personal information is shared only where necessary for the work of Padma Pura Foundation or where required by law.", "Information is retained only for as long as reasonably necessary for the purpose for which it was collected and for any applicable administrative or legal obligations."] },
		{ heading: "Your rights", paragraphs: ["Under applicable data protection law, you may have rights regarding your personal information, including the right to request access, correction or deletion.", "For questions or requests concerning your personal information, please contact:"] },
		{ heading: "Website technology", paragraphs: ["This website does not currently use analytics, advertising trackers or marketing cookies."] },
	],
};
---

<BaseLayout
	title="Privacy | Padma Pura Foundation"
	description="How Padma Pura Foundation handles personal information."
>
	<section class="privacy-opening" aria-labelledby="privacy-heading">
		<p class="privacy-opening__label">Privacy</p>
		<h1 id="privacy-heading">Privacy</h1>
		<p class="privacy-opening__intro">{copy.intro}</p>
	</section>

	<section class="privacy" aria-label="Privacy information">
		{copy.blocks.map((block, index) => <div class="privacy__block">
			<h2>{block.heading}</h2>
			<div class="privacy__prose">
				{block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				{index === 3 && <p><a href="mailto:info@padmapura.com">info@padmapura.com</a></p>}
			</div>
		</div>)}
	</section>
</BaseLayout>

<style>
	.privacy-opening {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-7), 8vw, 8rem);
		margin-inline: auto;
	}

	.privacy-opening__label {
		margin: 0 0 var(--space-6);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.privacy-opening h1 {
		max-width: 16ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3rem, 5.5vw, 5rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 1.02;
		font-optical-sizing: auto;
	}

	.privacy-opening__intro {
		max-width: 34rem;
		margin: clamp(var(--space-6), 5vw, var(--space-7)) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.privacy {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-8), 8vw, 7.5rem);
		margin-inline: auto;
	}

	.privacy__block {
		max-width: 42rem;
	}

	.privacy__block + .privacy__block {
		margin-top: clamp(var(--space-7), 6vw, var(--space-8));
	}

	.privacy__block h2 {
		margin: 0 0 var(--space-5);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.privacy__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.privacy__prose p + p {
		margin-top: var(--space-5);
	}

	@media (max-width: 48rem) {
		.privacy-opening {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.privacy-opening h1 {
			max-width: none;
			font-size: clamp(2.25rem, 10vw, 3rem);
			line-height: 1.05;
		}

		.privacy-opening__intro {
			max-width: none;
			margin-top: var(--space-6);
			font-size: var(--text-base);
		}

		.privacy {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.privacy__block {
			max-width: none;
		}
	}
</style>
