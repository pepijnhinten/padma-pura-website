---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Padma Pura" description="Padma Pura.">
	<section class="teacher-introduction" aria-labelledby="teacher-name">
		<div class="teacher-introduction__copy">
			<p class="teacher-introduction__label">Our Teacher</p>
			<h1 id="teacher-name">Tenzin Samphel Rinpoche</h1>
		</div>

		<figure class="teacher-portrait">
			<img
				class="teacher-portrait__image"
				src="/images/rinpoche/tenzin-samphel-reference.jpeg"
				alt="Tenzin Samphel Rinpoche"
			/>
		</figure>
	</section>

	<section class="upcoming" aria-labelledby="upcoming-heading">
		<div class="upcoming__heading">
			<h2 id="upcoming-heading">Upcoming</h2>
		</div>

		<div class="upcoming__list">
			<article class="upcoming__item">
				<h3>Tsog Practice</h3>
				<p>Date to be confirmed</p>
			</article>
			<article class="upcoming__item">
				<h3>Rinpoche in the Netherlands</h3>
				<p>Dates to be confirmed</p>
			</article>
		</div>
	</section>

	<section class="lineage" aria-labelledby="lineage-heading">
		<div class="lineage__intro">
			<h2 id="lineage-heading">Lineage &amp; Transmission</h2>
		</div>
		<div class="lineage__content">
			<div class="lineage__nyingma">
				<h3>Nyingma</h3>
				<p>Tenzin Samphel Rinpoche holds and transmits several transmission lineages and practice cycles within the Nyingma tradition.</p>
			</div>
			<div class="lineage__tersar">
				<h3>Dudjom Tersar</h3>
				<p>Dudjom Tersar has a central place in many of the practices, empowerments, oral transmissions and teachings Rinpoche gives during Padma Pura activities.</p>
			</div>
		</div>
	</section>

	<section class="dharma-activity" aria-labelledby="dharma-activity-heading">
		<div class="dharma-activity__heading">
			<h2 id="dharma-activity-heading">Dharma Activity</h2>
		</div>
		<ul class="dharma-activity__list">
			<li>Teachings &amp; Empowerments</li>
			<li>Practice</li>
			<li>Tsetar</li>
		</ul>
	</section>

	<section class="photographic-intermezzo" aria-label="Tenzin Samphel Rinpoche teaching">
		<figure class="photographic-intermezzo__figure">
			<img
				class="photographic-intermezzo__image"
				src="/images/home/rinpoche-teaching-reference.webp"
				alt="Tenzin Samphel Rinpoche during a teaching"
				width="1366"
				height="768"
			/>
		</figure>
	</section>

	<section class="padma-pura" aria-labelledby="padma-pura-heading">
		<h2 id="padma-pura-heading">Padma Pura</h2>
		<p>Padma Pura supports the Dharma activity of Tenzin Samphel Rinpoche in the Netherlands.</p>
	</section>

	<section class="support" aria-labelledby="support-heading">
		<div class="support__introduction">
			<h2 id="support-heading">Support</h2>
			<p>Support Padma Pura and help make Rinpoche's Dharma activity in the Netherlands possible.</p>
		</div>
		<ul class="support__options">
			<li>Donate</li>
			<li>Tsetar Fund</li>
			<li>Contribute</li>
		</ul>
	</section>
</BaseLayout>

<style>
	.teacher-introduction {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
		align-items: end;
		gap: clamp(var(--space-5), 4vw, var(--space-7));
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-block: clamp(var(--space-7), 6vh, var(--space-8));
		margin-inline: auto;
	}

	.teacher-introduction__copy {
		padding-bottom: clamp(var(--space-5), 4vh, var(--space-7));
	}

	.teacher-introduction__label {
		margin: 0 0 var(--space-5);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.teacher-introduction h1 {
		max-width: 10ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.25rem, 6.5vw, 6.5rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 0.98;
		font-optical-sizing: auto;
	}

	.teacher-portrait {
		width: 100%;
		max-width: 21rem;
		margin: 0;
		justify-self: end;
	}

	.teacher-portrait__image {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center top;
	}

	.upcoming {
		--upcoming-inline-padding: var(--space-6);
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-top: clamp(var(--space-8), 10vw, 8rem);
		margin-inline: max(var(--upcoming-inline-padding), (100% - var(--content-width)) / 2);
		border-top: 1px solid var(--color-border);
	}

	.upcoming__heading {
		width: min(100%, var(--content-width-narrow));
		padding-bottom: clamp(var(--space-6), 5vw, var(--space-8));
	}

	.upcoming h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 380;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.upcoming__list {
		border-top: 1px solid var(--color-border);
	}

	.upcoming__item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.45fr);
		gap: var(--space-5);
		align-items: baseline;
		padding-block: var(--space-5);
		border-bottom: 1px solid var(--color-border);
	}

	.upcoming__item h3,
	.upcoming__item p {
		margin: 0;
		font-family: var(--font-sans);
	}

	.upcoming__item h3 {
		font-size: var(--text-lg);
		font-weight: 450;
		line-height: 1.25;
	}

	.upcoming__item p {
		color: var(--color-muted);
		font-size: var(--text-base);
		line-height: 1.4;
	}

	.lineage {
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-top: clamp(var(--space-8), 11vw, 9rem);
		margin-inline: auto;
	}

	.lineage__intro {
		width: min(100%, var(--content-width-narrow));
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.lineage h2,
	.lineage h3,
	.lineage p {
		margin: 0;
	}

	.lineage h2,
	.lineage h3 {
		font-family: var(--font-display);
		font-optical-sizing: auto;
	}

	.lineage h2 {
		font-size: clamp(1.5rem, 2vw, 2.25rem);
		font-weight: 360;
		line-height: 1.1;
	}

	.lineage__content {
		padding-top: clamp(var(--space-8), 8vw, var(--space-9));
		padding-bottom: clamp(var(--space-8), 10vw, 8rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(var(--space-8), 8vw, 8rem);
		align-items: start;
	}

	.lineage__nyingma {
		grid-column: 1;
		padding-right: clamp(var(--space-5), 4vw, var(--space-8));
	}

	.lineage__tersar {
		grid-column: 2;
		padding-top: clamp(var(--space-6), 3vw, var(--space-8));
	}

	.lineage .lineage__tersar h3 {
		font-size: clamp(1.8rem, 3.1vw, 3.96rem);
	}

	.lineage h3 {
		font-size: clamp(2rem, 3.5vw, 4.5rem);
		font-weight: 360;
		line-height: 1.1;
		margin-bottom: var(--space-4);
	}

	.lineage p {
		max-width: 28rem;
		color: var(--color-foreground);
		font-family: var(--font-sans);
		font-size: clamp(1.0625rem, 1.15vw, 1.125rem);
		font-weight: 400;
		line-height: 1.6;
	}

	.padma-pura {
		display: grid;
		grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(var(--space-6), 7vw, 8rem);
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-block: clamp(var(--space-7), 5.5vw, 6rem) clamp(var(--space-7), 7vw, var(--space-9));
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
	}

	.padma-pura h2,
	.padma-pura p {
		margin: 0;
	}

	.padma-pura h2 {
		padding-top: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.padma-pura p {
		max-width: 30rem;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.support {
		display: block;
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-block: clamp(var(--space-7), 6vw, var(--space-8)) clamp(var(--space-8), 10vw, 8rem);
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
	}

	.support__introduction {
		margin-bottom: clamp(var(--space-8), 8vw, var(--space-9));
	}

	.photographic-intermezzo {
		width: 100%;
		padding-block: clamp(var(--space-6), 4vw, var(--space-7));
		background-color: var(--color-background);
	}

	.photographic-intermezzo__figure {
		width: calc(100% - (var(--space-6) * 2));
		max-width: clamp(50rem, 90%, var(--content-width));
		margin-inline: auto;
		margin-block: 0;
	}

	.photographic-intermezzo__image {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: center center;
	}

	@media (max-width: 48rem) {
		.photographic-intermezzo {
			padding-block: var(--space-7);
		}

		.photographic-intermezzo__figure {
			width: calc(100% - (var(--space-5) * 2));
			max-width: none;
		}

		.photographic-intermezzo__image {
			aspect-ratio: 16 / 9;
		}
	}

	.support h2,
	.support p,
	.support__options {
		margin: 0;
	}
		padding-block: var(--space-7) clamp(var(--space-8), 10vw, 8rem);
	.support h2 {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2vw, 2.25rem);
		font-weight: 360;
		line-height: 1.1;
		font-optical-sizing: auto;
		padding-bottom: var(--space-5);
	}

	.support__introduction p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
		color: var(--color-foreground);
	}

	.support__options {
		padding: 0;
		margin: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: clamp(var(--space-6), 4vw, var(--space-8));
	}

	.support__options li {
		padding: 0;
		border: none;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 1.5vw, 1.5rem);
		font-weight: 380;
		line-height: 1.3;
		color: var(--color-foreground);
	}

	@media (max-width: 48rem) {
		.teacher-introduction {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-7);
			min-height: auto;
			padding-block: var(--space-7) var(--space-8);
		}

		.teacher-introduction__copy {
			padding: 0;
		}

		.teacher-introduction h1 {
			max-width: 12ch;
			font-size: clamp(2.75rem, 13vw, 4.5rem);
			line-height: 1;
		}

		.teacher-portrait {
			width: min(82%, 22rem);
			align-self: flex-end;
		}

		.teacher-portrait__image {
			aspect-ratio: 4 / 5;
			object-fit: contain;
			object-position: center top;
		}

		.upcoming {
			--upcoming-inline-padding: var(--space-5);
			width: calc(100% - (var(--space-5) * 2));
			padding-top: var(--space-8);
			margin-inline: var(--upcoming-inline-padding);
		}

		.upcoming__heading {
			padding-bottom: var(--space-6);
		}

		.upcoming__item {
			grid-template-columns: 1fr;
			gap: var(--space-2);
			padding-block: var(--space-5);
		}

		.lineage {
			width: calc(100% - (var(--space-5) * 2));
			padding-top: var(--space-8);
			margin-inline: auto;
		}

		.lineage__content {
			grid-template-columns: 1fr;
			gap: var(--space-7);
			padding-top: var(--space-7);
			padding-bottom: var(--space-8);
		}

		.lineage__nyingma {
			grid-column: auto;
			padding-right: 0;
		}

		.lineage__tersar {
			grid-column: auto;
			padding-top: 0;
		}

		.lineage h3 {
			font-size: clamp(2rem, 8vw, 2.75rem);
		}

		.lineage .lineage__tersar h3 {
			font-size: clamp(2rem, 8vw, 2.75rem);
		}

		.lineage p {
			max-width: 100%;
			padding-top: var(--space-3);
			font-size: var(--text-base);
		}

		.padma-pura {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-7) var(--space-8);
		}

		.padma-pura h2 {
			padding: 0 0 var(--space-5);
		}

		.support {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-7);
		}

		.support__introduction {
			margin-bottom: var(--space-7);
		}

		.support h2 {
			font-size: var(--text-lg);
			padding-bottom: var(--space-4);
		}

		.support__options {
			gap: var(--space-5);
		}

	}
</style>

<style is:global>
	.dharma-activity {
		display: grid;
		grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(var(--space-6), 7vw, 8rem);
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-block: clamp(var(--space-7), 7vw, var(--space-9)) clamp(var(--space-7), 7vw, var(--space-9));
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
	}

	.dharma-activity__heading {
		padding-top: var(--space-2);
	}

	.dharma-activity h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 360;
		line-height: 1.1;
		font-optical-sizing: auto;
	}

	.dharma-activity__list {
		padding: 0;
		margin: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.dharma-activity__list li {
		padding-block: clamp(var(--space-5), 3vw, var(--space-6));
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3vw, 3.25rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	@media (max-width: 48rem) {
		.dharma-activity {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-7) var(--space-8);
		}

		.dharma-activity__heading {
			padding: 0 0 var(--space-7);
		}

		.dharma-activity__list li {
			padding-block: var(--space-5);
			font-size: clamp(1.75rem, 9vw, 2.5rem);
		}
	}
</style>
