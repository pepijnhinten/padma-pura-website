---
const leftLinks = [
	{ href: "/our-teacher", label: "Our Teacher" },
	{ href: "/lineage", label: "Lineage" },
];

const rightLinks = [
	{ href: "/activities", label: "Activities" },
	{ href: "/padma-pura", label: "Padma Pura Foundation" },
	{ href: "/support", label: "Support" },
];

const navigationLinks = [...leftLinks, ...rightLinks];
---

<header class="site-header">
	<div class="site-header__inner">
		<nav class="site-header__nav site-header__nav--left" aria-label="Primary navigation">
			{leftLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
		</nav>

		<a class="site-header__identity" href="/" aria-label="Padma Pura Foundation home">
			<img src="/brand/padma-pura-seal.png" alt="Padma Pura Foundation seal" />
		</a>

		<nav class="site-header__nav site-header__nav--right" aria-label="Primary navigation">
			{rightLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
		</nav>

		<details class="site-menu">
			<summary>Menu</summary>
			<nav aria-label="Primary navigation">
				{navigationLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		width: min(100% - (var(--space-6) * 2), 70rem);
		min-height: 9.5rem;
		margin-inline: auto;
	}

	.site-header__nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(var(--space-4), 1.5vw, var(--space-5));
		row-gap: var(--space-2);
		font-family: var(--font-sans);
		font-size: clamp(0.9375rem, 0.9rem + 0.1vw, 1rem);
		font-weight: 500;
		letter-spacing: 0.015em;
		line-height: 1.3;
	}

	.site-header__nav--left {
		justify-content: flex-start;
	}

	.site-header__nav--right {
		justify-content: flex-end;
	}

	.site-header__nav a,
	.site-menu a {
		color: var(--color-foreground);
		text-decoration: none;
	}

	.site-header__nav a:hover,
	.site-menu a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.site-header__identity {
		display: block;
		width: 6rem;
		margin-inline: clamp(var(--space-6), 4vw, var(--space-8));
	}

	.site-header__identity img {
		display: block;
		width: 100%;
		height: auto;
	}

	.site-menu {
		display: none;
	}

	@media (max-width: 48rem) {
		.site-header__inner {
			grid-template-columns: 1fr auto 1fr;
			grid-template-rows: auto auto;
			width: min(100% - (var(--space-5) * 2), 38rem);
			min-height: 7rem;
		}

		.site-header__nav {
			display: none;
		}

		.site-header__identity {
			grid-row: 1;
			grid-column: 2;
			width: 4.75rem;
			padding: var(--space-1);
			margin: 0;
		}

		.site-menu {
			display: grid;
			grid-template-rows: 4.75rem auto;
			grid-row: 1 / 3;
			grid-column: 1 / -1;
		}

		.site-menu summary {
			display: flex;
			grid-row: 1;
			align-self: center;
			justify-self: end;
			align-items: center;
			min-height: 2.75rem;
			cursor: pointer;
			color: var(--color-foreground);
			font-family: var(--font-sans);
			font-size: clamp(0.9375rem, 0.9rem + 0.1vw, 1rem);
			font-weight: 500;
			letter-spacing: 0.015em;
			line-height: 1.3;
			list-style: none;
		}

		.site-menu summary::-webkit-details-marker {
			display: none;
		}

		.site-menu nav {
			display: grid;
			grid-row: 2;
			gap: var(--space-1);
			width: 100%;
			margin-top: var(--space-4);
			padding-top: var(--space-3);
			padding-bottom: var(--space-5);
			border-top: 1px solid var(--color-border);
		}

		.site-menu a {
			display: flex;
			align-items: center;
			min-height: 2.75rem;
		}
	}
</style>