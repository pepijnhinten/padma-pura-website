---
import BaseLayout from "../layouts/BaseLayout.astro";
import { upcomingVisit } from "../data/upcoming";
import type { Locale } from "../lib/locale";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const isDutch = locale === "nl";
const copy = isDutch ? {
	label: "Activiteiten", heading: "Dharma-activiteiten", opening: ["De Dharma-activiteit van Tenzin Samphel Rinpoche in Nederland omvat onderricht, inwijdingen, mondelinge overdrachten, beoefeningsinstructies en gelegenheden om samen te beoefenen.", "Padma Pura Foundation ondersteunt deze activiteiten en helpt de voorwaarden te scheppen waaronder studenten Rinpoche’s onderricht kunnen ontvangen en onder zijn begeleiding kunnen beoefenen."],
	upcoming: "Komend bezoek", upcomingIntro: "Informatie over het jaarlijkse bezoek van Tenzin Samphel Rinpoche aan Nederland.", visits: "Rinpoche in Nederland", visitsText: ["Tenzin Samphel Rinpoche bezoekt Nederland jaarlijks om onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies te geven en studenten te ontmoeten.", "Padma Pura Foundation ondersteunt de organisatie van deze jaarlijkse bezoeken en de Dharma-activiteiten die tijdens deze bezoeken plaatsvinden. Bevestigde data en praktische informatie worden gepubliceerd bij Komend bezoek."],
	tsogHeading: "Tsog", tsogText: ["Tsog is een Vajrayana-groepsbeoefening waarin beoefenaars samenkomen voor beoefening en offerandes.", "Padma Pura Foundation organiseert Tsog-beoefening doorgaans online via Microsoft Teams, rond Guru Rinpoche Dag en Dakini Dag wanneer de omstandigheden dit toelaten."], tsogParticipation: "Als u wilt deelnemen, kunt u e-mailen naar", tsogMailing: "We voegen u toe aan de Tsog-mailinglijst, waarop uitnodigingen en praktische informatie over komende Tsog-beoefeningen worden gedeeld.",
	tsetar: "Tsetar", tsetarText: ["Tsetar is de boeddhistische beoefening waarbij dieren worden gered uit situaties waarin ze anders zouden worden gedood en worden vrijgelaten in omstandigheden waarin ze hun leven kunnen voortzetten.", "Padma Pura Foundation ondersteunt Tsetar-activiteiten onder begeleiding van Rinpoche. Omdat deze activiteiten zorgvuldige voorbereiding vereisen, wordt praktische informatie alleen gedeeld waar dat passend is."],
	gutor: "Gutor", gutorText: "Gutor is een Vajrayana-beoefening die traditioneel vóór Losar, het Tibetaans Nieuwjaar, wordt gehouden. Het is een beoefening van zuivering en het wegnemen van obstakels, die helpt gunstige omstandigheden voor het komende jaar te scheppen.", mailing: "Algemene mailinglijst", closing: "Belangrijke updates en informatie over Rinpoche’s activiteiten worden gedeeld via de algemene mailinglijst, samen met informatie over andere activiteiten van Padma Pura Foundation, waaronder Tsetar en Gutor. Om u aan te melden voor de algemene mailinglijst, kunt u e-mailen naar",
	upcomingAttribution: "van Mipham Rinpoche", upcomingPeriod: "Verwacht in juni / juli 2027", upcomingStatus: "Data nog niet bevestigd", seriesNote: "Het volgende jaarlijkse bezoek van Rinpoche aan Nederland wordt momenteel verwacht in juni of juli 2027. Dit zou het tweede jaar zijn van onderricht over Sword of Wisdom for Thoroughly Ascertaining Reality van Mipham Rinpoche, als vervolg op de in 2026 begonnen reeks.", detailsStatus: "Data, locatie en programma worden gepubliceerd zodra deze zijn bevestigd.",
} : {
	label: "Activities", heading: "Dharma Activity", opening: ["Tenzin Samphel Rinpoche’s Dharma activity in the Netherlands includes teachings, empowerments, oral transmissions, practice guidance and opportunities to practise together.", "Padma Pura Foundation supports these activities and helps create the conditions for students to receive Rinpoche’s teachings and practise under his guidance."],
	upcoming: "Upcoming", upcomingIntro: "Information about Tenzin Samphel Rinpoche’s annual visit to the Netherlands.", visits: "Rinpoche in the Netherlands", visitsText: ["Tenzin Samphel Rinpoche visits the Netherlands annually to give teachings, empowerments, oral transmissions and practice guidance, and to meet with students.", "Padma Pura Foundation supports the organisation of these annual visits and the Dharma activities that take place during them. Confirmed dates and practical information are published in Upcoming."],
	tsogHeading: "Tsog practice", tsogText: ["Tsog is a Vajrayana group practice in which practitioners come together for practice and offerings.", "Padma Pura Foundation usually organises Tsog practice online via Microsoft Teams, around Guru Rinpoche Day and Dakini Day when circumstances allow."], tsogParticipation: "If you would like to take part, please email", tsogMailing: "We will add you to the Tsog mailing list, through which invitations and practical information for upcoming Tsog practices are shared.",
	tsetar: "Tsetar", tsetarText: ["Tsetar is the Buddhist practice of saving animals from situations in which they would otherwise be killed and releasing them into conditions where they can continue their lives.", "Padma Pura Foundation supports Tsetar activities under Rinpoche’s guidance. Because these activities require careful preparation, information is shared only when and where appropriate."],
	gutor: "Gutor", gutorText: "Gutor is a Vajrayana practice traditionally held before Losar, the Tibetan New Year. It is a practice of purification and the clearing of obstacles, helping create auspicious conditions for the year ahead.", mailing: "General mailing list", closing: "Important updates and information about Rinpoche’s activities are shared through the general mailing list, together with information about other Padma Pura Foundation activities, including Tsetar and Gutor. To join the general mailing list, please email",
	upcomingAttribution: upcomingVisit.attribution, upcomingPeriod: upcomingVisit.expectedPeriod, upcomingStatus: upcomingVisit.status, seriesNote: upcomingVisit.seriesNote, detailsStatus: upcomingVisit.detailsStatus,
};
const localizedUpcoming = { ...upcomingVisit, attribution: copy.upcomingAttribution, expectedPeriod: copy.upcomingPeriod, status: copy.upcomingStatus, seriesNote: copy.seriesNote, detailsStatus: copy.detailsStatus };
---

<BaseLayout
	title="Dharma Activity — Padma Pura Foundation"
	description="Dharma activities connected with Tenzin Samphel Rinpoche and Padma Pura Foundation in the Netherlands."
>
	<section class="activities-opening" aria-labelledby="activities-heading">
		<p class="activities-opening__label">{copy.label}</p>
		<h1 id="activities-heading">{copy.heading}</h1>
		<div class="activities-opening__intro">
			{copy.opening.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section class="upcoming" aria-labelledby="upcoming-heading">
		<div class="upcoming__heading">
			<h2 id="upcoming-heading">{copy.upcoming}</h2>
			<p class="upcoming__intro">{copy.upcomingIntro}</p>
		</div>
		<ul class="upcoming__list">
			<li class="upcoming__item">
				<div class="upcoming__name">
					<span class="upcoming__title">{upcomingVisit.title}</span>
					<span class="upcoming__subtitle">{localizedUpcoming.attribution}</span>
				</div>
				<div class="upcoming__status">
					<span>{localizedUpcoming.expectedPeriod}</span>
					<span>{localizedUpcoming.status}</span>
				</div>
				<p class="upcoming__description" set:html={localizedUpcoming.seriesNote.replace(localizedUpcoming.title, `<em>${localizedUpcoming.title}</em>`)}></p>
				<p class="upcoming__closing">{localizedUpcoming.detailsStatus}</p>
			</li>
		</ul>
	</section>

	<section class="visits" aria-labelledby="visits-heading">
		<h2 id="visits-heading">{copy.visits}</h2>
		<div class="visits__prose">
			{copy.visitsText.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<figure class="visits__image">
			<img src="/images/activities/rinpoche-with-students.jpg" alt="Tenzin Samphel Rinpoche in conversation with students" />
		</figure>
	</section>

	<section class="tsog" aria-labelledby="tsog-heading">
		<h2 id="tsog-heading">{copy.tsogHeading}</h2>
		<div class="tsog__prose">
			{copy.tsogText.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<div class="tsog__participation">
			<p>{copy.tsogParticipation} <a href="mailto:info@padmapura.com">info@padmapura.com</a>. {copy.tsogMailing}</p>
		</div>
		<div class="tsog__images">
			<figure>
				<img src="/images/activities/guru-tsokye-tuktik.jpg" alt="Guru Tsokye Tuktik thangka" />
				<figcaption>Tsokye Thugthig</figcaption>
			</figure>
			<figure>
				<img src="/images/activities/khandro-tuktik.jpg" alt="Khandro Tuktik thangka" />
				<figcaption>Khandro Thugthig</figcaption>
			</figure>
		</div>
	</section>

	<section class="tsetar" aria-labelledby="tsetar-heading">
		<h2 id="tsetar-heading">{copy.tsetar}</h2>
		<div class="tsetar__prose">
			{copy.tsetarText.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<figure class="tsetar__image">
			<img src="/images/activities/tsetar.png" alt="Tsetar activity" />
		</figure>
	</section>

	<section class="gutor" aria-labelledby="gutor-heading">
		<h2 id="gutor-heading">{copy.gutor}</h2>
		<div class="gutor__prose">
			<p>{copy.gutorText}</p>
		</div>
		<figure class="gutor__image">
			<img src="/images/activities/gutor.png" alt="Gutor practice" />
			<figcaption>Phurba Putri Repung</figcaption>
		</figure>
	</section>

	<section class="activities-closing" aria-labelledby="activities-closing-heading">
		<h2 id="activities-closing-heading">{copy.mailing}</h2>
		<p>{copy.closing} <a href="mailto:info@padmapura.com">info@padmapura.com</a>.</p>
	</section>
</BaseLayout>

<style>
	.activities-opening {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-7), 8vw, 8rem);
		margin-inline: auto;
	}

	.activities-opening__label {
		margin: 0 0 var(--space-6);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.activities-opening h1 {
		max-width: 14ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 6.5vw, 6rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 0.98;
		font-optical-sizing: auto;
	}

	.activities-opening__intro {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(var(--space-6), 5vw, var(--space-8));
		max-width: var(--content-width);
		margin-top: clamp(var(--space-7), 5.8vw, 5.5rem);
	}

	.activities-opening__intro p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.upcoming {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-8), 8vw, 7.5rem);
		margin-inline: auto;
	}

	.upcoming__heading {
		width: min(100%, var(--content-width-narrow));
		padding-bottom: clamp(var(--space-6), 5vw, var(--space-8));
	}

	.upcoming h2 {
		margin: 0 0 var(--space-4);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.upcoming__intro {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.5;
	}

	.upcoming__list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.upcoming__item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.45fr);
		gap: var(--space-5);
		align-items: baseline;
		padding-block: var(--space-5);
		border-bottom: 1px solid var(--color-border);
	}

	.upcoming__name {
		color: inherit;
		font-family: var(--font-sans);
		font-weight: 450;
		line-height: 1.25;
	}

	.upcoming__title,
	.upcoming__subtitle,
	.upcoming__closing {
		display: block;
	}

	.upcoming__title {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 380;
		line-height: 1.15;
	}

	.upcoming__subtitle {
		display: block;
		margin-top: var(--space-3);
		color: var(--color-muted);
		font-size: var(--text-base);
		font-weight: 400;
	}

	.upcoming__status {
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.4;
	}

	.upcoming__status span {
		display: block;
	}

	.upcoming__status span + span {
		margin-top: var(--space-3);
		font-size: var(--text-sm);
	}

	.upcoming__description,
	.upcoming__closing {
		grid-column: 1 / -1;
		max-width: 42rem;
		margin: var(--space-6) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.upcoming__closing {
		margin-top: var(--space-4);
		color: var(--color-muted);
	}

	.upcoming__empty {
		margin: 0;
		padding-block: var(--space-5);
		border-block: 1px solid var(--color-border);
		color: var(--color-muted);
	}

	.visits {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 8vw, 8rem);
		margin-inline: auto;
	}

	.visits h2 {
		max-width: 18ch;
		margin: 0 0 var(--space-7);
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 3.5vw, 3rem);
		font-weight: 360;
		line-height: 1.1;
		font-optical-sizing: auto;
	}

	.visits__prose {
		max-width: 42rem;
	}

	.visits__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.visits__prose p + p {
		margin-top: var(--space-6);
	}

	.visits__image {
		width: 70%;
		margin: calc(var(--space-8) * 0.75) 0 0;
	}

	.visits__image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.tsog {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 8vw, 8rem);
		margin-inline: auto;
	}

	.tsog h2 {
		max-width: 16ch;
		margin: 0 0 var(--space-7);
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 4vw, 3.25rem);
		font-weight: 380;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.tsog__prose {
		max-width: 42rem;
	}

	.tsog__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.tsog__prose p + p {
		margin-top: var(--space-6);
	}

	.tsog__participation {
		max-width: 42rem;
		margin-top: var(--space-7);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.tsog__participation p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.tsog__images {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: flex-start;
		gap: var(--space-5);
		width: 68%;
		margin-top: var(--space-8);
	}

	.tsog__images img {
		display: block;
		width: 100%;
		height: auto;
	}

	.tsog__images figure {
		margin: 0;
	}

	.tsog__images figcaption {
		margin-top: var(--space-2);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.4;
		text-align: left;
	}

	.tsetar {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7.5vw, 7.5rem);
		margin-inline: auto;
	}

	.tsetar h2 {
		max-width: 16ch;
		margin: 0 0 var(--space-7);
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 3.75vw, 3rem);
		font-weight: 370;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.tsetar__prose {
		max-width: 42rem;
	}

	.tsetar__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.tsetar__prose p + p {
		margin-top: var(--space-6);
	}

	.tsetar__image {
		width: 48%;
		margin: calc(var(--space-8) * 0.75) 0 0;
	}

	.tsetar__image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.gutor {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.gutor h2,
	.gutor p {
		margin: 0;
	}

	.gutor h2 {
		margin-bottom: var(--space-7);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.gutor__prose {
		max-width: 42rem;
	}

	.gutor__image {
		grid-column: 1 / -1;
		width: min(48%, 34.56rem);
		margin: var(--space-7) 0 0;
	}

	.gutor__image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.gutor__image figcaption {
		margin-top: var(--space-2);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.4;
		text-align: left;
	}

	.gutor p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.activities-closing {
		display: grid;
		grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr);
		gap: clamp(var(--space-6), 6vw, var(--space-8));
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-top: var(--space-6);
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		border-top: 1px solid var(--color-border);
		margin-inline: auto;
	}

	.activities-closing h2,
	.activities-closing p {
		margin: 0;
	}

	.activities-closing h2 {
		padding-top: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.activities-closing p {
		max-width: 34rem;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	@media (max-width: 48rem) {
		.activities-opening {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.activities-opening h1 {
			max-width: none;
			font-size: clamp(2.75rem, 12vw, 4rem);
			line-height: 1.02;
		}

		.activities-opening__intro {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-6);
			margin-top: var(--space-7);
		}

		.activities-opening__intro p {
			font-size: var(--text-base);
		}

		.upcoming {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.upcoming__heading {
			width: 100%;
		}

		.upcoming__item {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-2);
			padding-block: var(--space-5);
		}

		.visits {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.visits h2 {
			max-width: none;
			margin-bottom: var(--space-6);
			font-size: clamp(2rem, 8vw, 2.5rem);
		}

		.visits__prose {
			max-width: none;
			margin-top: 0;
		}

		.visits__image {
			width: 100%;
			margin-top: var(--space-7);
		}

		.tsog {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.tsog h2 {
			max-width: none;
			margin: 0 0 var(--space-6);
			font-size: clamp(2rem, 8vw, 2.5rem);
		}

		.tsog__prose {
			max-width: none;
		}

		.tsog__participation {
			max-width: none;
			margin-top: var(--space-6);
			padding-top: var(--space-5);
		}

		.tsog__images {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-7);
			width: 82%;
			margin-top: var(--space-7);
		}

		.tsog__images img {
			width: 100%;
		}

		.tsetar {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.tsetar h2 {
			max-width: none;
			margin: 0 0 var(--space-6);
			font-size: clamp(2rem, 8vw, 2.5rem);
		}

		.tsetar__prose {
			max-width: none;
			margin-left: 0;
		}

		.tsetar__image {
			width: 100%;
			margin-top: var(--space-7);
