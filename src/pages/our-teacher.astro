---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLocalizedPath, type Locale } from "../lib/locale";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const copy = locale === "nl"
	? {
		label: "Onze leraar",
		intro: "Het leven van Tenzin Samphel Rinpoche staat in het teken van studie, beoefening en de overdracht van de Dharma. Zijn Dharma-activiteit is geworteld in de Nyingma-traditie, in de overdrachtslijnen die hij heeft ontvangen en voortzet, en in de beoefeningscycli die hij diepgaand heeft bestudeerd en beoefend.",
		biographyHeading: "Biografie",
		biography: [
			"Tenzin Samphel Rinpoche werd in 1961 geboren in Spiti, in de Indiase Himalaya. Hij begon zijn monastieke studie in het klooster van Kyabjé Dudjom Rinpoche in Orissa, India. Later studeerde en beoefende hij twaalf jaar aan Urgyen Dongak Chöling, het klooster van Dudjom Rinpoche in Boudhanath, Kathmandu, Nepal. Vervolgens gaf hij in hetzelfde klooster boeddhisme en filosofie onder begeleiding van Khetsun Sangpo Rinpoche.",
			"In 1987 verhuisde Rinpoche op verzoek van Dudjom Rinpoche naar Frankrijk om daar zijn Dharma-activiteit als lama en leraar voort te zetten.",
			"In 1999 richtte Tenzin Samphel Rinpoche, met het advies en de aanmoediging van Khetsun Sangpo Rinpoche, Shedup Kunsang Chöling in Frankrijk op. Na een traditionele rituele ceremonie benoemde Khetsun Sangpo Rinpoche hem tot lineagehouder en vertrouwde hem de spirituele verantwoordelijkheid over het centrum toe. Rinpoche woont daar sinds 2002 en geeft onderricht en begeleiding aan beoefenaars.",
			"Rinpoche woont in Shedup Kunsang Chöling met zijn Amerikaanse vrouw, bij studenten bekend als Khandro-la, en hun vier zonen. Zijn gezinsleven is een belangrijk onderdeel van de lekencontext waarin hij leeft, beoefent en zijn Dharma-activiteit verricht.",
		],
		trainingHeading: "Opleiding en leraren",
		training: [
			"Tijdens zijn opleiding ontving Tenzin Samphel Rinpoche onderricht, inwijdingen en mondelinge overdrachten van vele bekwame meesters van de Nyingma-traditie. Tot zijn belangrijkste leraren behoorden Kyabjé Dudjom Rinpoche, Dilgo Khyentse Rinpoche, Chadral Rinpoche en Khetsun Sangpo Rinpoche.",
			"Rinpoche houdt verschillende overdrachtslijnen en beoefeningscycli binnen de Nyingma-traditie en draagt deze over. Dudjom Tersar neemt een centrale plaats in binnen veel van de beoefeningen die hij door middel van inwijdingen, mondelinge overdrachten en onderricht overdraagt. Daarnaast houdt hij onder meer de overdrachtslijnen van Yangti Nagpo en Longchen Nyingthig.",
		],
		shedup: [
			"Shedup Kunsang Chöling is een boeddhistisch centrum in Septvaux, Frankrijk, dat in 1999 door Tenzin Samphel Rinpoche werd opgericht met het advies en de aanmoediging van Khetsun Sangpo Rinpoche.",
			"Het is een belangrijk centrum voor Rinpoche’s Dharma-activiteit in Frankrijk. Hij geeft er onderricht, inwijdingen en beoefeningsinstructies, en studenten en beoefenaars komen er samen voor retraites, onderricht en gezamenlijke beoefening.",
		],
		teachingHeading: "Dharma-onderricht",
		teaching: [
			"Rinpoche geeft onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies, waarbij hij de Dharma overdraagt overeenkomstig de behoeften en omstandigheden van zijn studenten.",
			"Zijn Dharma-onderricht vindt zijn centrum in Shedup Kunsang Chöling en strekt zich uit tot bezoeken elders, waaronder zijn jaarlijkse bezoeken aan Nederland. Padma Pura Foundation ondersteunt deze bezoeken en de daarmee verbonden Dharma-activiteiten, waardoor studenten zijn begeleiding kunnen ontvangen en samen kunnen beoefenen.",
		],
		academicHeading: "Academisch werk",
		academic: [
			"Naast zijn Dharma-activiteit heeft Rinpoche ook bijgedragen aan academisch werk op het gebied van de Tibetaanse taal en boeddhistische tradities.",
			"Hij gaf acht jaar les aan Inalco in Parijs, waar hij ook bijdroeg aan onderzoek binnen de Tibetologie. Daarnaast heeft hij gewerkt met promovendi aan Rice University in Houston.",
		],
		lineageHeading: "Lineage & overdracht",
		lineageText: "Lees meer over de Nyingma-traditie en de overdrachtslijnen en beoefeningscycli die deel uitmaken van Rinpoche’s opleiding en Dharma-activiteit.",
		lineageLink: "Ontdek Lineage & overdracht",
	}
	: {
		label: "Our Teacher",
		intro: "Tenzin Samphel Rinpoche’s life has been devoted to the study, practice and transmission of the Dharma. His training and Dharma activity are rooted in the Nyingma tradition, in transmission lineages he has received and continues to transmit, and in practice cycles he has studied and practised.",
		biographyHeading: "Biography",
		biography: [
			"Born in 1961 in Spiti, in the Indian Himalayas, Tenzin Samphel Rinpoche began his monastic studies at Kyabjé Dudjom Rinpoche’s monastery in Orissa, India. He later spent twelve years studying and practising at Urgyen Dongak Chöling, Dudjom Rinpoche’s monastery in Boudhanath, Kathmandu, Nepal. He subsequently taught Buddhism and philosophy at the same monastery under the guidance of Khetsun Sangpo Rinpoche.",
			"In 1987, at the request of Dudjom Rinpoche, Rinpoche moved to France to continue his Dharma activity there as a lama and teacher.",
			"In 1999, with the advice and encouragement of Khetsun Sangpo Rinpoche, Tenzin Samphel Rinpoche established Shedup Kunsang Chöling in France. Following a traditional ritual ceremony, Khetsun Sangpo Rinpoche enthroned him as a lineage holder and entrusted him with spiritual authority at the centre. Rinpoche has lived there since 2002, teaching and guiding practitioners.",
			"Rinpoche lives at Shedup Kunsang Chöling with his American wife, known to students as Khandro-la, and their four sons. His family life is an important part of the householder context in which he lives, practises and carries out his Dharma activity.",
		],
		trainingHeading: "Training and teachers",
		training: [
			"Throughout his training, Tenzin Samphel Rinpoche received teachings, empowerments and oral transmissions from many accomplished masters of the Nyingma tradition. Among his principal teachers were Kyabjé Dudjom Rinpoche, Dilgo Khyentse Rinpoche, Chadral Rinpoche and Khetsun Sangpo Rinpoche.",
			"Rinpoche holds and transmits several transmission lineages and practice cycles within the Nyingma tradition. Dudjom Tersar has a central place in many of the practices he transmits through empowerments, oral transmissions and teachings. He also holds transmission lineages of Yangti Nagpo and Longchen Nyingthig, among others.",
		],
		shedup: [
			"Shedup Kunsang Chöling is a Buddhist centre in Septvaux, France, established by Tenzin Samphel Rinpoche in 1999 with the advice and encouragement of Khetsun Sangpo Rinpoche.",
			"It is an important centre for Rinpoche’s Dharma activity in France, where he gives teachings, empowerments and practice guidance and where students and practitioners gather for retreats, teachings and group practice.",
		],
		teachingHeading: "Teaching activity",
		teaching: [
			"Rinpoche gives teachings, empowerments, oral transmissions and practice guidance, transmitting the Dharma according to the needs and circumstances of his students.",
			"His teaching activity is centred at Shedup Kunsang Chöling and extends through visits elsewhere, including his annual visits to the Netherlands. Padma Pura Foundation supports these visits and the related Dharma activities through which students receive his guidance and practise together.",
		],
		academicHeading: "Academic work",
		academic: [
			"Alongside his Dharma activity, Rinpoche has also contributed to academic work relating to Tibetan language and Buddhist traditions.",
			"He taught for eight years at Inalco in Paris, where he also contributed to research in Tibetology. He has also worked with graduate students at Rice University in Houston.",
		],
		lineageHeading: "Lineage & Transmission",
		lineageText: "Learn more about the Nyingma tradition and the transmission lineages and practice cycles that form part of Rinpoche’s training and Dharma activity.",
		lineageLink: "Explore Lineage & Transmission",
	};

const localizedPath = (path: string) => getLocalizedPath(path, locale);
---

<BaseLayout
	title="Our Teacher | Padma Pura Foundation"
	description="Tenzin Samphel Rinpoche, teacher in the Nyingma tradition of Tibetan Buddhism."
>
	<section class="teacher-opening" aria-labelledby="teacher-heading">
		<div class="teacher-opening__copy">
			<header class="teacher-opening__heading">
				<p class="teacher-opening__label">{copy.label}</p>
				<h1 id="teacher-heading">Tenzin Samphel Rinpoche</h1>
			</header>

			<p class="teacher-opening__intro">
				{copy.intro}
			</p>
		</div>

		<figure class="teacher-opening__portrait">
			<img
				src="/images/rinpoche/tenzin-samphel-reference.png"
				alt="Tenzin Samphel Rinpoche"
				width="1430"
				height="2048"
			/>
		</figure>
	</section>

	<section class="biography" aria-labelledby="biography-heading">
		<h2 id="biography-heading">{copy.biographyHeading}</h2>
		<div class="biography__prose">
			{copy.biography.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section class="training" aria-labelledby="training-heading">
		<h2 id="training-heading">{copy.trainingHeading}</h2>
		<div class="training__prose">
			{copy.training.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section class="shedup" aria-labelledby="shedup-heading">
		<h2 id="shedup-heading">Shedup Kunsang Chöling</h2>
		<div class="shedup__prose">
			{copy.shedup.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<img class="shedup__image" src="/images/rinpoche/shedup-kunsang-choling.webp" alt="Shedup Kunsang Chöling in Septvaux, France" />
	</section>

	<section class="teaching" aria-labelledby="teaching-heading">
		<h2 id="teaching-heading">{copy.teachingHeading}</h2>
		<div class="teaching__prose">
			{copy.teaching.map((paragraph) => <p>{paragraph}</p>)}
		</div>
		<figure class="teaching__image">
			<img
				src="/images/home/rinpoche-teaching-reference.webp"
				alt="Tenzin Samphel Rinpoche during a teaching"
				width="1366"
				height="768"
				loading="lazy"
			/>
		</figure>
	</section>

	<section class="academic" aria-labelledby="academic-heading">
		<h2 id="academic-heading">{copy.academicHeading}</h2>
		<div class="academic__prose">
			{copy.academic.map((paragraph) => <p>{paragraph}</p>)}
		</div>
	</section>

	<section class="lineage-transition" aria-labelledby="lineage-transition-heading">
		<h2 id="lineage-transition-heading">{copy.lineageHeading}</h2>
		<p>{copy.lineageText}</p>
		<p class="lineage-transition__link">
			<a href={localizedPath("/lineage")}>{copy.lineageLink}</a>
		</p>
	</section>
</BaseLayout>

<style>
	.teacher-opening {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(16rem, 28%);
		gap: clamp(var(--space-6), 7vw, var(--space-8));
		align-items: start;
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-8), 8vw, 7.5rem);
		margin-inline: auto;
	}

	.teacher-opening__copy {
		max-width: 44rem;
	}

	.teacher-opening__heading {
		margin: 0;
	}

	.teacher-opening__label {
		margin: 0 0 var(--space-5);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.teacher-opening h1 {
		max-width: 9ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 6vw, 6.25rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 0.98;
		font-optical-sizing: auto;
	}

	.teacher-opening__intro {
		max-width: 38rem;
		padding-top: clamp(var(--space-6), 5vw, var(--space-8));
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.teacher-opening__portrait {
		width: 100%;
		max-width: 18rem;
		margin: 0;
		justify-self: end;
	}

	.teacher-opening__portrait img {
		display: block;
		width: 100%;
		height: auto;
	}

	.biography {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.biography h2,
	.biography p {
		margin: 0;
	}

	.biography h2 {
		margin-bottom: var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.biography__prose {
		max-width: 42rem;
	}

	.biography p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.biography p + p {
		margin-top: var(--space-6);
	}

	.training {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.training h2,
	.training p {
		margin: 0;
	}

	.training h2 {
		margin-bottom: var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.training__prose {
		max-width: 42rem;
	}

	.training p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.training p + p {
		margin-top: var(--space-6);
	}

	.shedup {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.shedup h2 {
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.shedup__prose {
		max-width: 42rem;
	}

	.shedup__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.shedup__prose p + p {
		margin-top: var(--space-6);
	}

	.shedup__image {
		display: block;
		width: 60%;
		max-width: 47rem;
		height: auto;
		margin-top: clamp(var(--space-6), 4vw, var(--space-7));
	}

	.teaching {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.teaching h2 {
		margin: 0 0 var(--space-6);
		font-family: var(--font-display);
		font-size: 2.9375rem;
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.teaching__prose {
		max-width: 46rem;
	}

	.teaching__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.teaching__prose p + p {
		margin-top: var(--space-6);
	}

	.teaching__image {
		width: 70%;
		max-width: 60rem;
		margin: clamp(var(--space-6), 4vw, var(--space-7)) 0 0;
	}

	.teaching__image img {
		display: block;
		width: 100%;
		height: auto;
	}

	.academic {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-7), 7vw, 7rem);
		margin-inline: auto;
	}

	.academic h2,
	.academic p {
		margin: 0;
	}

	.academic h2 {
		margin-bottom: var(--space-6);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.academic__prose {
		max-width: 42rem;
	}

	.academic p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.academic p + p {
		margin-top: var(--space-6);
	}

	.lineage-transition {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-7), 6vw, var(--space-8));
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
	}

	.lineage-transition h2 {
		margin: 0 0 var(--space-4);
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
		font-weight: 360;
		line-height: 1.1;
		font-optical-sizing: auto;
	}

	.lineage-transition p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.lineage-transition__link {
		margin-top: var(--space-5);
		font-weight: 500;
	}

	@media (max-width: 48rem) {
		.teacher-opening {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.teacher-opening h1 {
			max-width: 10ch;
			font-size: clamp(3rem, 13vw, 4.5rem);
			line-height: 1;
		}

		.teacher-opening__intro {
			max-width: 30rem;
			padding-top: var(--space-7);
			font-size: var(--text-lg);
		}

		.teacher-opening__portrait {
			width: min(76%, 20rem);
			max-width: none;
			margin: var(--space-8) auto 0;
		}

		.biography {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.biography h2 {
			margin-bottom: var(--space-6);
		}

		.biography p {
			font-size: var(--text-base);
		}

		.training {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.training h2 {
			margin-bottom: var(--space-6);
		}

		.training p {
			font-size: var(--text-base);
		}

		.shedup {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.shedup h2 {
			margin: 0 0 var(--space-6);
		}

		.shedup__prose {
			max-width: none;
		}

		.shedup__prose p {
			font-size: var(--text-base);
		}

		.shedup__image {
			width: 100%;
			margin-top: var(--space-7);
		}

		.teaching {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.teaching h2 {
			margin: 0 0 var(--space-6);
			font-size: clamp(2rem, 8vw, 2.5rem);
		}

		.teaching__prose {
			max-width: none;
		}

		.teaching__prose p {
			font-size: var(--text-base);
		}

		.teaching__image {
			width: 100%;
			max-width: none;
			margin-top: var(--space-7);
		}

		.academic {
			display: block;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.academic h2 {
			margin-bottom: var(--space-6);
		}

		.academic p {
			font-size: var(--text-base);
		}

		.lineage-transition {
			max-width: none;
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-7);
		}

		.lineage-transition p {
			font-size: var(--text-base);
		}
	}
</style>