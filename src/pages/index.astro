---
import BaseLayout from "../layouts/BaseLayout.astro";
import { upcomingVisit } from "../data/upcoming";
import { getLocalizedPath, type Locale } from "../lib/locale";

interface Props {
	locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isDutch = locale === "nl";
const copy = isDutch
	? {
		teacherLabel: "Onze leraar",
		teacherIntro: "Tenzin Samphel Rinpoche is een leraar binnen de Nyingma-traditie van het Tibetaans boeddhisme. Zijn leven is gewijd aan studie, beoefening en de overdracht van de Dharma.",
		teacherLink: "Over Tenzin Samphel Rinpoche →",
		upcomingHeading: "Komend bezoek",
		upcomingIntro: "Rinpoche bezoekt Nederland jaarlijks om onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies te geven.",
		lineageHeading: "Lineage & overdracht",
		lineageContext: "Rinpoche’s Dharma-activiteiten zijn geworteld in de levende overdracht van de Nyingma-traditie. Door onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies ontvangen studenten onderricht en beoefeningen die van leraar op leerling door generaties heen zijn overgedragen.",
		lineageNyingma: "Tenzin Samphel Rinpoche is houder van verschillende overdrachtslijnen en beoefeningscycli binnen de Nyingma-traditie en draagt deze over.",
		lineageLabel: "Binnen de Nyingma-traditie",
		lineageTersar: "Dudjom Tersar neemt een centrale plaats in binnen veel van de beoefeningen, inwijdingen, mondelinge overdrachten en het onderricht dat Rinpoche geeft tijdens activiteiten van Padma Pura Foundation.",
		lineageLink: "Meer over Lineage & overdracht →",
		dharmaHeading: "Dharma-activiteiten",
		teachingsHeading: "Onderricht & inwijdingen",
		teachingsText: "Tijdens zijn jaarlijkse bezoeken aan Nederland geeft Rinpoche onderricht, inwijdingen, mondelinge overdrachten en beoefeningsinstructies, afgestemd op de behoeften van zijn studenten.",
		practiceText: "Studenten komen samen voor beoefening die verbonden is met Rinpoche’s onderricht en begeleiding. Tsog-beoefening wordt regelmatig georganiseerd; uitnodigingen en praktische informatie worden via de mailinglijst gedeeld.",
		tsetarText: "Padma Pura Foundation ondersteunt Tsetar-activiteiten die onder begeleiding van Rinpoche worden uitgevoerd. Omdat deze activiteiten zorgvuldige voorbereiding vereisen, wordt praktische informatie alleen gedeeld waar dat passend is.",
		activitiesLink: "Meer over activiteiten →",
		foundationText: "Padma Pura Foundation ondersteunt de Dharma-activiteiten van Tenzin Samphel Rinpoche in Nederland en helpt de praktische voorwaarden te scheppen voor zijn jaarlijkse bezoeken, onderricht, overdrachten en beoefeningsactiviteiten.",
		foundationText2: "Door Rinpoche’s onderricht en begeleiding worden studenten aangemoedigd compassie en een goed hart te ontwikkelen, terwijl zij begrip en vaardigheden ontwikkelen om zichzelf en anderen effectiever te kunnen helpen.",
		foundationLink: "Over Padma Pura Foundation →",
		supportHeading: "Steun",
		supportIntro: "Steun Padma Pura Foundation en help Rinpoche’s Dharma-activiteiten in Nederland mogelijk te maken.",
		annualSupport: "Jaarlijkse bijdrage",
		annualSupportText: "Regelmatige bijdragen ondersteunen Rinpoche’s Dharma-activiteiten en het doorlopende werk van Padma Pura Foundation in Nederland.",
		tsetarFund: "Tsetar-fonds",
		tsetarFundText: "Bijdragen aan het Tsetar-fonds helpen Tsetar-activiteiten onder begeleiding van Rinpoche mogelijk te maken.",
		practicalSupport: "Praktische ondersteuning",
		practicalSupportText: "Vrijwilligers helpen met het praktische werk rond Rinpoche’s bezoeken, onderricht en andere Dharma-activiteiten.",
		supportLink: "Meer over steun →",
	}
	: {
		teacherLabel: "Our Teacher",
		teacherIntro: "Tenzin Samphel Rinpoche is a teacher in the Nyingma tradition of Tibetan Buddhism. His life has been devoted to study, practice and the transmission of the Dharma.",
		teacherLink: "About Tenzin Samphel Rinpoche →",
		upcomingHeading: "Upcoming",
		upcomingIntro: "Rinpoche visits the Netherlands annually to give teachings, empowerments, oral transmissions and practice guidance.",
		lineageHeading: "Lineage & Transmission",
		lineageContext: "Rinpoche’s Dharma activity is rooted in the living transmission of the Nyingma tradition. Through teachings, empowerments, oral transmissions and practice guidance, students receive teachings and practices that have been transmitted from teacher to student through generations.",
		lineageNyingma: "Tenzin Samphel Rinpoche holds and transmits several transmission lineages and practice cycles within the Nyingma tradition.",
		lineageLabel: "Within the Nyingma tradition",
		lineageTersar: "Dudjom Tersar has a central place in many of the practices, empowerments, oral transmissions and teachings Rinpoche gives during Padma Pura Foundation activities.",
		lineageLink: "Explore Lineage & Transmission →",
		dharmaHeading: "Dharma Activity",
		teachingsHeading: "Teachings & Empowerments",
		teachingsText: "During his annual visits to the Netherlands, Rinpoche gives teachings, empowerments, oral transmissions and practice guidance according to the needs of his students.",
		practiceText: "Students gather for practice connected with Rinpoche’s teachings and guidance. Tsog practice is organised regularly, with invitations and practical information shared through the mailing list.",
		tsetarText: "Padma Pura Foundation supports Tsetar activities carried out under Rinpoche’s guidance. Because these activities require careful preparation, practical information is shared only where appropriate.",
		activitiesLink: "Explore Activities →",
		foundationText: "Padma Pura Foundation supports the Dharma activity of Tenzin Samphel Rinpoche in the Netherlands and helps create the practical conditions for his annual visits, teachings, transmissions and practice activities.",
		foundationText2: "Through Rinpoche’s teachings and guidance, students are encouraged to cultivate compassion and a good heart, while developing the understanding and skills to help themselves and others more effectively.",
		foundationLink: "About Padma Pura Foundation →",
		supportHeading: "Support",
		supportIntro: "Support Padma Pura Foundation and help make Rinpoche's Dharma activity in the Netherlands possible.",
		annualSupport: "Annual Support",
		annualSupportText: "Regular contributions help support Rinpoche’s Dharma activity and the ongoing work of Padma Pura Foundation in the Netherlands.",
		tsetarFund: "Tsetar Fund",
		tsetarFundText: "Contributions to the Tsetar Fund help make Tsetar activities under Rinpoche’s guidance possible.",
		practicalSupport: "Practical support",
		practicalSupportText: "Volunteers help with the practical work around Rinpoche’s visits, teachings and other Dharma activities.",
		supportLink: "Explore Support →",
	};

const localizedPath = (path: string) => getLocalizedPath(path, locale);
const localizedUpcoming = isDutch
	? { ...upcomingVisit, attribution: "van Mipham Rinpoche", expectedPeriod: "Verwacht in juni / juli 2027", status: "Data nog niet bevestigd" }
	: upcomingVisit;
---

<BaseLayout title="Padma Pura Foundation" description="Padma Pura Foundation.">
	<section class="teacher-introduction" aria-labelledby="teacher-name">
		<div class="teacher-introduction__copy">
			<p class="teacher-introduction__label">{copy.teacherLabel}</p>
			<h1 id="teacher-name">Tenzin Samphel Rinpoche</h1>
			<p class="teacher-introduction__text">{copy.teacherIntro}</p>
			<p class="teacher-introduction__link"><a href={localizedPath("/our-teacher")}>{copy.teacherLink}</a></p>
		</div>

		<figure class="teacher-portrait">
			<img
				class="teacher-portrait__image"
				src="/images/rinpoche/tenzin-samphel-reference.png"
				alt="Tenzin Samphel Rinpoche"
			/>
		</figure>
	</section>

	<section class="upcoming" aria-labelledby="upcoming-heading">
		<div class="upcoming__heading">
			<h2 id="upcoming-heading">{copy.upcomingHeading}</h2>
			<p>{copy.upcomingIntro}</p>
		</div>

		<div class="upcoming__list">
			<article class="upcoming__item">
				<div class="upcoming__primary">
					<h3>{localizedUpcoming.title}</h3>
					<p>{localizedUpcoming.attribution}</p>
				</div>
				<div class="upcoming__status">
					<p>{localizedUpcoming.expectedPeriod}</p>
					<p>{localizedUpcoming.status}</p>
				</div>
			</article>
		</div>
	</section>

	<section class="lineage" aria-labelledby="lineage-heading">
		<div class="lineage__intro">
			<h2 id="lineage-heading">{copy.lineageHeading}</h2>
		</div>
		<p class="lineage__context">{copy.lineageContext}</p>
		<div class="lineage__composition">
			<figure class="lineage__image">
				<img src="/images/home/lineage-transmission.png" alt="Lineage and Transmission" />
			</figure>
			<div class="lineage__content">
				<div class="lineage__nyingma">
					<h3>Nyingma</h3>
					<p>{copy.lineageNyingma}</p>
				</div>
				<div class="lineage__tersar">
					<p class="lineage__tersar-label">{copy.lineageLabel}</p>
					<h3>Dudjom Tersar</h3>
					<p>{copy.lineageTersar}</p>
				</div>
			</div>
		</div>
		<p class="lineage__link"><a href={localizedPath("/lineage")}>{copy.lineageLink}</a></p>
	</section>

	<section class="dharma-activity" aria-labelledby="dharma-activity-heading">
		<div class="dharma-activity__heading">
			<h2 id="dharma-activity-heading">{copy.dharmaHeading}</h2>
		</div>
		<div class="dharma-activity__composition">
			<figure class="dharma-activity__image">
				<img src="/images/home/dharma-wheel1.png" alt="Dharma wheel" />
			</figure>
			<ul class="dharma-activity__list">
				<li>
					<h3>{copy.teachingsHeading}</h3>
					<p>{copy.teachingsText}</p>
				</li>
				<li>
					<h3>Practice</h3>
					<p>{copy.practiceText}</p>
				</li>
				<li>
					<h3>Tsetar</h3>
					<p>{copy.tsetarText}</p>
				</li>
			</ul>
		</div>
		<p class="dharma-activity__link"><a href={localizedPath("/activities")}>{copy.activitiesLink}</a></p>
	</section>

	<section class="padma-pura" aria-labelledby="padma-pura-heading">
		<div class="padma-pura__heading">
			<h2 id="padma-pura-heading">Padma Pura Foundation</h2>
		</div>
		<div class="padma-pura__composition">
			<figure class="padma-pura__logo">
				<img src="/brand/padma-pura-seal.png" alt="Padma Pura Foundation seal" />
			</figure>
			<div class="padma-pura__copy">
				<p>{copy.foundationText}</p>
				<p>{copy.foundationText2}</p>
				<p class="padma-pura__link"><a href={localizedPath("/padma-pura")}>{copy.foundationLink}</a></p>
			</div>
		</div>
	</section>

	<section class="support" aria-labelledby="support-heading">
		<div class="support__introduction">
			<h2 id="support-heading">{copy.supportHeading}</h2>
			<p>{copy.supportIntro}</p>
		</div>
		<ul class="support__options">
			<li class="support__option">
				<h3 class="support__option-title">{copy.annualSupport}</h3>
				<p class="support__option-description">{copy.annualSupportText}</p>
			</li>
			<li class="support__option">
				<h3 class="support__option-title">{copy.tsetarFund}</h3>
				<p class="support__option-description">{copy.tsetarFundText}</p>
			</li>
			<li class="support__option">
				<h3 class="support__option-title">{copy.practicalSupport}</h3>
				<p class="support__option-description">{copy.practicalSupportText}</p>
			</li>
		</ul>
		<div class="support__closing">
			<p class="support__link"><a href={localizedPath("/support")}>{copy.supportLink}</a></p>
		</div>
	</section>
</BaseLayout>

<style>
	.teacher-introduction {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
		align-items: end;
		gap: clamp(var(--space-5), 4vw, var(--space-7));
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-block: clamp(var(--space-7), 6vh, var(--space-8));
		margin-inline: auto;
	}

	.teacher-introduction__copy {
		padding-bottom: clamp(var(--space-5), 4vh, var(--space-7));
	}

	.teacher-introduction__label {
		margin: 0 0 var(--space-5);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.teacher-introduction h1 {
		max-width: 10ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.25rem, 6.5vw, 6.5rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 0.98;
		font-optical-sizing: auto;
	}

	.teacher-introduction__text {
		max-width: 34rem;
		margin: var(--space-6) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.teacher-introduction__link {
		margin: var(--space-5) 0 0;
		font-size: var(--text-sm);
	}

	.teacher-portrait {
		width: 100%;
		max-width: 23.5rem;
		margin: 0;
		justify-self: end;
		transform: translateY(var(--space-6));
	}

	.teacher-portrait__image {
		display: block;
		width: 100%;
		height: auto;
	}

	.upcoming {
		--upcoming-inline-padding: var(--space-6);
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-top: clamp(var(--space-8), 7.5vw, var(--space-9));
		margin-inline: max(var(--upcoming-inline-padding), (100% - var(--content-width)) / 2);
		border-top: 1px solid var(--color-border);
	}

	.upcoming__heading {
		width: min(100%, var(--content-width-narrow));
		padding-bottom: clamp(var(--space-6), 5vw, var(--space-8));
	}

	.upcoming h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 380;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.upcoming__heading p {
		max-width: 38rem;
		margin: var(--space-4) 0 0;
		font-size: var(--text-base);
		line-height: 1.6;
	}

	.upcoming__list {
		border-top: 1px solid var(--color-border);
	}

	.upcoming__item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.45fr);
		gap: var(--space-5);
		align-items: baseline;
		padding-block: var(--space-5);
		border-bottom: 1px solid var(--color-border);
	}

	.upcoming__item h3,
	.upcoming__item p {
		margin: 0;
		font-family: var(--font-sans);
	}

	.upcoming__item h3 {
		font-size: var(--text-lg);
		font-weight: 450;
		line-height: 1.25;
	}

	.upcoming__item h3 a {
		color: inherit;
	}

	.upcoming__item p {
		color: var(--color-muted);
		font-size: var(--text-base);
		line-height: 1.4;
	}

	.upcoming__primary p,
	.upcoming__status p + p {
		margin-top: var(--space-2);
	}

	.upcoming__status p + p {
		font-size: var(--text-sm);
	}

	.upcoming__empty {
		margin: 0;
		padding-block: var(--space-5);
		border-block: 1px solid var(--color-border);
		color: var(--color-muted);
	}

	.lineage {
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-top: clamp(var(--space-8), 11vw, 9rem);
		margin-inline: auto;
	}

	.lineage__intro {
		width: min(100%, var(--content-width-narrow));
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.lineage h2,
	.lineage h3,
	.lineage p {
		margin: 0;
	}

	.lineage h2,
	.lineage h3 {
		font-family: var(--font-display);
		font-optical-sizing: auto;
	}

	.lineage h2 {
		font-size: clamp(2rem, 3.5vw, 3.25rem);
		font-weight: 360;
		line-height: 1.05;
	}

	.lineage .lineage__context {
		max-width: 46rem;
		margin-top: clamp(var(--space-6), 4vw, var(--space-7));
		color: var(--color-foreground);
		font-family: var(--font-sans);
		font-size: 1.0625rem;
		font-weight: 400;
		line-height: 1.6;
		font-optical-sizing: auto;
	}

	.lineage__image {
		width: 100%;
		max-width: 1800px;
		margin: 0;
	}

	.lineage__image img {
		display: block;
		width: 100%;
		max-width: 1800px;
		height: auto;
	}

	.lineage__composition {
		display: grid;
		grid-template-columns: minmax(0, 30%) minmax(0, 1fr);
		gap: clamp(var(--space-6), 7vw, var(--space-8));
		align-items: start;
		margin-top: clamp(var(--space-6), 4vw, var(--space-7));
	}

	.lineage__content {
		max-width: 42rem;
		padding-bottom: clamp(var(--space-5), 2.5vw, var(--space-6));
	}

	.lineage__nyingma {
		margin-bottom: clamp(var(--space-7), 5vw, var(--space-8));
	}

	.lineage__tersar {
		max-width: 42rem;
	}

	.lineage__tersar-label {
		margin-bottom: var(--space-3) !important;
		color: var(--color-muted) !important;
		font-size: var(--text-sm) !important;
	}

	.lineage .lineage__tersar h3 {
		font-size: clamp(1.75rem, 2.5vw, 2.5rem);
	}

	.lineage h3 {
		font-size: clamp(2rem, 3vw, 2.75rem);
		font-weight: 360;
		line-height: 1.1;
		margin-bottom: var(--space-4);
	}

	.lineage p {
		max-width: 28rem;
		color: var(--color-foreground);
		font-family: var(--font-sans);
		font-size: clamp(1.0625rem, 1.15vw, 1.125rem);
		font-weight: 400;
		line-height: 1.6;
	}

	.lineage__nyingma > p,
	.lineage__tersar > p:not(.lineage__tersar-label) {
		font-size: 1.0625rem;
	}

	.lineage .lineage__link {
		max-width: none;
		padding-top: clamp(var(--space-6), 4vw, var(--space-7));
		padding-bottom: clamp(var(--space-8), 10vw, 8rem);
		font-size: var(--text-sm);
	}

	.padma-pura {
		display: block;
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-block: clamp(var(--space-7), 5.5vw, 6rem) clamp(var(--space-7), 7vw, var(--space-9));
		margin-inline: auto;
	}

	.padma-pura__composition {
		display: grid;
		grid-template-columns: minmax(0, 24%) minmax(0, 1fr);
		gap: clamp(var(--space-6), 7vw, var(--space-8));
		align-items: start;
	}

	.padma-pura__heading {
		width: min(100%, var(--content-width-narrow));
		padding-bottom: calc(clamp(var(--space-6), 4vw, var(--space-7)) + var(--space-2));
	}

	.padma-pura__logo {
		width: 100%;
		max-width: 14rem;
		margin: 0;
	}

	.padma-pura__logo img {
		display: block;
		width: 100%;
		height: auto;
	}

	.padma-pura h2,
	.padma-pura p {
		margin: 0;
	}

	.padma-pura h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.5vw, 3.25rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.padma-pura p {
		max-width: 38rem;
		font-family: var(--font-sans);
		font-size: 1.0625rem;
		font-weight: 400;
		line-height: 1.6;
	}

	.padma-pura__copy > p:first-child {
		font-size: clamp(1.125rem, 1.4vw, 1.25rem);
		line-height: 1.55;
	}

	.padma-pura__copy > p + p:not(.padma-pura__link) {
		margin-top: var(--space-5);
	}

	.padma-pura .padma-pura__link {
		margin-top: var(--space-6);
		font-size: var(--text-sm);
	}

	.support {
		display: block;
		width: calc(100% - (var(--space-6) * 2));
		max-width: var(--content-width);
		padding-block: clamp(var(--space-7), 6vw, var(--space-8)) clamp(var(--space-8), 10vw, 8rem);
		margin-inline: auto;
		border-top: 1px solid var(--color-border);
	}

	.support__introduction {
		margin-bottom: clamp(var(--space-7), 5vw, var(--space-8));
	}

	.support p,
	.support__options {
		margin: 0;
	}

	.support h2 {
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.5vw, 3.25rem);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
		padding-bottom: var(--space-5);
	}

	.support__introduction p {
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
		color: var(--color-foreground);
	}

	.support__options {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		width: 100%;
		padding: 0;
		margin: 0;
		list-style: none;
		border-block: 1px solid var(--color-border);
	}

	.support__option {
		min-width: 0;
		padding: clamp(var(--space-6), 3vw, var(--space-7)) clamp(var(--space-5), 3vw, var(--space-7));
		border: 0;
	}

	.support__option + .support__option {
		border-left: 1px solid var(--color-border);
	}

	.support__option-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.4375rem, 1.8vw, 1.625rem);
		font-weight: 380;
		font-style: normal;
		line-height: 1.3;
		font-optical-sizing: auto;
		color: var(--color-foreground);
	}

