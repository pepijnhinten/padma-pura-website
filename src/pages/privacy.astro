---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/locale";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const copy = locale === "nl" ? {
	intro: "Padma Pura Foundation gaat zorgvuldig om met persoonsgegevens. In deze privacyverklaring leggen wij uit welke persoonsgegevens wij verwerken, waarom wij dat doen, met wie gegevens kunnen worden gedeeld, hoe lang wij gegevens bewaren en welke rechten u heeft.",
	blocks: [
		{ heading: "Verwerkingsverantwoordelijke", paragraphs: ["Padma Pura Foundation is verantwoordelijk voor de verwerking van persoonsgegevens zoals beschreven in deze privacyverklaring.", "Padma Pura Foundation", "E-mail: info@padmapura.com", "RSIN: 861789659"] },
		{ heading: "Welke persoonsgegevens wij verwerken", paragraphs: ["Afhankelijk van uw contact met Padma Pura Foundation kunnen wij persoonsgegevens verwerken zoals uw naam, e-mailadres en, waar nodig voor de praktische organisatie, uw telefoonnummer.", "Ook kunnen wij gegevens verwerken die u zelf verstrekt in e-mail of andere correspondentie, gegevens in verband met inschrijving of deelname aan activiteiten, lidmaatschap en toegang tot het Members Portal, beperkte vrijwilligersgegevens zoals beschikbaarheid en toegewezen taken, en gegevens over donaties en betalingen zoals naam van de rekeninghouder, IBAN, bedrag, datum en betalingsomschrijving.", "Wij verwerken alleen persoonsgegevens die redelijkerwijs nodig zijn voor het betreffende doel."] },
		{ heading: "Waarvoor wij persoonsgegevens gebruiken", paragraphs: ["Wij kunnen persoonsgegevens gebruiken voor het beantwoorden van vragen en e-mailberichten, het versturen van nieuws en aankondigingen via de mailinglijst, het organiseren van teachings, bijeenkomsten en andere activiteiten, ledenadministratie en toegang tot het Members Portal, praktische coördinatie van vrijwilligers, administratie van donaties en betalingen en het voldoen aan wettelijke en administratieve verplichtingen."] },
		{ heading: "Grondslagen", paragraphs: ["Afhankelijk van de verwerking baseren wij de verwerking van persoonsgegevens op toestemming, de uitvoering van een afspraak of overeenkomst, een wettelijke verplichting of een gerechtvaardigd belang van Padma Pura Foundation.", "Een gerechtvaardigd belang kan bijvoorbeeld bestaan uit noodzakelijke organisatorische en administratieve werkzaamheden, voor zover de belangen en privacyrechten van betrokkenen niet zwaarder wegen.", "Wanneer een verwerking op toestemming is gebaseerd, kunt u die toestemming altijd intrekken."] },
		{ heading: "Mailinglijst", paragraphs: ["Wanneer u zich aanmeldt voor de mailinglijst, gebruiken wij uw naam en/of e-mailadres om informatie te sturen over Padma Pura Foundation, teachings, activiteiten en aanverwante onderwerpen.", "U kunt zich op ieder moment afmelden door contact op te nemen via info@padmapura.com of via een afmeldmogelijkheid in een bericht, indien aanwezig."] },
		{ heading: "Activiteiten en vrijwilligers", paragraphs: ["Voor de organisatie van activiteiten kunnen wij contact- en registratiegegevens verwerken.", "Van vrijwilligers kunnen beperkte persoonsgegevens voorkomen in bijvoorbeeld een draaiboek of planning. Deze gegevens worden alleen gebruikt voor de praktische organisatie van de betreffende activiteit."] },
		{ heading: "Members Portal en Microsoft 365", paragraphs: ["Het Members Portal van Padma Pura Foundation wordt aangeboden via Microsoft 365 en SharePoint.", "Voor het verlenen en beheren van toegang kunnen persoonsgegevens worden verwerkt binnen de Microsoft 365-omgeving. Microsoft levert hiervoor diensten aan Padma Pura Foundation en verwerkt daarbij gegevens overeenkomstig de toepasselijke privacy- en gegevensbeschermingsvoorwaarden."] },
		{ heading: "Donaties en financiële administratie", paragraphs: ["Wanneer u een donatie of andere betaling doet, kunnen gegevens zoals uw naam, bankrekeningnummer, bedrag, datum en betalingsomschrijving zichtbaar zijn in onze financiële administratie.", "Wij gebruiken deze gegevens voor het verwerken van betalingen, de financiële administratie en het voldoen aan wettelijke verplichtingen.", "Gegevens die onderdeel zijn van de wettelijk verplichte financiële administratie worden bewaard gedurende de toepasselijke wettelijke bewaartermijn."] },
		{ heading: "Bewaartermijnen", paragraphs: ["Wij bewaren persoonsgegevens niet langer dan nodig is voor het doel waarvoor zij zijn verzameld, tenzij een wettelijke bewaarplicht geldt.", "E-mail- en contactgegevens worden verwijderd wanneer zij niet langer nodig zijn voor het betreffende contact of de administratie. Mailinglijstgegevens worden bewaard totdat u zich afmeldt of de mailinglijst wordt beëindigd. Gegevens over activiteiten en vrijwilligers worden verwijderd wanneer zij niet langer nodig zijn voor organisatie of verantwoording. Ledengegevens worden bewaard zolang dit nodig is voor het lidmaatschap en de ledenadministratie. Financiële administratie wordt bewaard gedurende de wettelijk vereiste periode."] },
		{ heading: "Delen van persoonsgegevens", paragraphs: ["Wij verkopen geen persoonsgegevens.", "Persoonsgegevens worden alleen gedeeld wanneer dit noodzakelijk is voor onze activiteiten, wanneer wij gebruikmaken van een dienstverlener of wanneer wij daartoe wettelijk verplicht zijn.", "Dienstverleners kunnen bijvoorbeeld Microsoft 365/SharePoint, e-maildiensten, hostingdiensten, banken en administratieve dienstverleners zijn."] },
		{ heading: "Doorgifte buiten de EER", paragraphs: ["Sommige dienstverleners kunnen persoonsgegevens buiten de Europese Economische Ruimte verwerken. Wanneer dit gebeurt, wordt gebruikgemaakt van toepasselijke waarborgen voor gegevensbescherming overeenkomstig de AVG."] },
		{ heading: "Website, cookies en externe links", paragraphs: ["De publieke website padmapura.org gebruikt momenteel geen analytics, advertentietrackers of marketingcookies.", "De website bevat gewone links naar externe websites, waaronder Facebook en YouTube. Wanneer u zo'n link volgt, verlaat u padmapura.org en is het privacybeleid van de betreffende externe partij van toepassing."] },
		{ heading: "Beveiliging", paragraphs: ["Wij nemen passende technische en organisatorische maatregelen om persoonsgegevens te beschermen tegen verlies, onbevoegde toegang, misbruik en ongeoorloofde wijziging."] },
		{ heading: "Uw privacyrechten", paragraphs: ["U heeft onder de AVG, voor zover van toepassing, het recht om uw persoonsgegevens in te zien, onjuiste gegevens te laten corrigeren, gegevens te laten verwijderen, de verwerking te laten beperken, bezwaar te maken tegen bepaalde verwerkingen, gegevens over te dragen en eerder gegeven toestemming in te trekken.", "Voor vragen of verzoeken over uw persoonsgegevens kunt u contact opnemen via info@padmapura.com.", "Wij kunnen u vragen uw identiteit voldoende aan te tonen voordat wij een verzoek uitvoeren."] },
		{ heading: "Klachten", paragraphs: ["Als u vragen of zorgen heeft over de verwerking van uw persoonsgegevens, kunt u eerst contact met ons opnemen via info@padmapura.com.", "U heeft daarnaast het recht om een klacht in te dienen bij de Autoriteit Persoonsgegevens."] },
		{ heading: "Wijzigingen", paragraphs: ["Wij kunnen deze privacyverklaring aanpassen wanneer onze werkwijze, dienstverlening of wettelijke verplichtingen veranderen. De actuele versie wordt op deze website gepubliceerd."] },
	],
} : {
	intro: "Padma Pura Foundation handles personal data with care. This privacy statement explains which personal data we process, why we process it, with whom data may be shared, how long it is retained and what rights you have.",
	blocks: [
		{ heading: "Data controller", paragraphs: ["Padma Pura Foundation is responsible for the processing of personal data described in this privacy statement.", "Padma Pura Foundation", "Email: info@padmapura.com", "RSIN: 861789659"] },
		{ heading: "Personal data we process", paragraphs: ["Depending on your contact with Padma Pura Foundation, we may process personal data such as your name, email address and, where needed for practical organisation, your telephone number.", "We may also process information you provide in email or other correspondence, information relating to registration for or participation in activities, membership and access to the Members Portal, limited volunteer information such as availability and assigned tasks, and donation and payment information such as account holder name, IBAN, amount, date and payment description.", "We process only personal data that are reasonably necessary for the relevant purpose."] },
		{ heading: "Why we use personal data", paragraphs: ["We may use personal data to respond to questions and email, send news and announcements through the mailing list, organise teachings, gatherings and other activities, administer membership and Members Portal access, coordinate volunteers, administer donations and payments and comply with legal and administrative obligations."] },
		{ heading: "Legal bases", paragraphs: ["Depending on the processing, we rely on consent, performance of an agreement or arrangement, compliance with a legal obligation or a legitimate interest of Padma Pura Foundation.", "A legitimate interest may include necessary organisational and administrative activities, provided that these interests are not overridden by the interests and privacy rights of the individuals concerned.", "Where processing is based on consent, you may withdraw that consent at any time."] },
		{ heading: "Mailing list", paragraphs: ["When you join the mailing list, we use your name and/or email address to send information about Padma Pura Foundation, teachings, activities and related matters.", "You can unsubscribe at any time by contacting info@padmapura.com or by using an unsubscribe option in a message where available."] },
		{ heading: "Activities and volunteers", paragraphs: ["For the organisation of activities we may process contact and registration information.", "Limited personal data of volunteers may appear in, for example, an event plan or schedule. These data are used only for the practical organisation of the relevant activity."] },
		{ heading: "Members Portal and Microsoft 365", paragraphs: ["The Padma Pura Foundation Members Portal is provided through Microsoft 365 and SharePoint.", "Personal data may be processed within the Microsoft 365 environment to provide and manage access. Microsoft provides these services to Padma Pura Foundation and processes data in accordance with the applicable privacy and data protection terms."] },
		{ heading: "Donations and financial administration", paragraphs: ["When you make a donation or other payment, information such as your name, bank account number, amount, date and payment description may appear in our financial administration.", "We use this information to process payments, maintain our financial administration and comply with legal obligations.", "Data forming part of legally required financial records are retained for the applicable statutory retention period."] },
		{ heading: "Retention", paragraphs: ["We do not retain personal data longer than necessary for the purpose for which they were collected, unless a legal retention obligation applies.", "Email and contact information are deleted when no longer needed for the relevant contact or administration. Mailing list data are retained until you unsubscribe or the mailing list is discontinued. Activity and volunteer information is deleted when no longer needed for organisation or accountability. Membership data are retained for as long as necessary for membership and membership administration. Financial records are retained for the legally required period."] },
		{ heading: "Sharing personal data", paragraphs: ["We do not sell personal data.", "Personal data are shared only where necessary for our activities, where we use a service provider or where we are legally required to do so.", "Service providers may include Microsoft 365/SharePoint, email providers, hosting providers, banks and administrative service providers."] },
		{ heading: "Transfers outside the EEA", paragraphs: ["Some service providers may process personal data outside the European Economic Area. Where this occurs, applicable safeguards for data protection are used in accordance with the GDPR."] },
		{ heading: "Website, cookies and external links", paragraphs: ["The public website padmapura.org currently does not use analytics, advertising trackers or marketing cookies.", "The website contains ordinary links to external websites, including Facebook and YouTube. When you follow such a link, you leave padmapura.org and the privacy policy of the relevant external provider applies."] },
		{ heading: "Security", paragraphs: ["We take appropriate technical and organisational measures to protect personal data against loss, unauthorised access, misuse and unauthorised alteration."] },
		{ heading: "Your privacy rights", paragraphs: ["Under the GDPR, where applicable, you have the right to access your personal data, have inaccurate data corrected, have data erased, restrict processing, object to certain processing, receive or transfer your data and withdraw previously given consent.", "For questions or requests concerning your personal data, please contact info@padmapura.com.", "We may ask you to provide sufficient proof of identity before carrying out a request."] },
		{ heading: "Complaints", paragraphs: ["If you have questions or concerns about how we process personal data, you can first contact us at info@padmapura.com.", "You also have the right to lodge a complaint with the Dutch Data Protection Authority (Autoriteit Persoonsgegevens)."] },
		{ heading: "Changes", paragraphs: ["We may update this privacy statement when our working practices, services or legal obligations change. The current version will be published on this website."] },
	],
};
---

<BaseLayout
	title="Privacy | Padma Pura Foundation"
	description="How Padma Pura Foundation handles personal information."
>
	<section class="privacy-opening" aria-labelledby="privacy-heading">
		<p class="privacy-opening__label">Privacy</p>
		<h1 id="privacy-heading">Privacy</h1>
		<p class="privacy-opening__intro">{copy.intro}</p>
	</section>

	<section class="privacy" aria-label="Privacy information">
		{copy.blocks.map((block) => <div class="privacy__block">
			<h2>{block.heading}</h2>
			<div class="privacy__prose">
				{block.paragraphs.map((paragraph) => paragraph.includes("info@padmapura.com") ? (
					<p>{paragraph.split("info@padmapura.com")[0]}<a href="mailto:info@padmapura.com">info@padmapura.com</a>{paragraph.split("info@padmapura.com")[1]}</p>
				) : <p>{paragraph}</p>)}
			</div>
		</div>)}
	</section>
</BaseLayout>

<style>
	.privacy-opening {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-block: clamp(var(--space-8), 9vw, 9rem) clamp(var(--space-7), 8vw, 8rem);
		margin-inline: auto;
	}

	.privacy-opening__label {
		margin: 0 0 var(--space-6);
		color: var(--color-muted);
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.privacy-opening h1 {
		max-width: 16ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3rem, 5.5vw, 5rem);
		font-weight: 380;
		letter-spacing: 0;
		line-height: 1.02;
		font-optical-sizing: auto;
	}

	.privacy-opening__intro {
		max-width: 34rem;
		margin: clamp(var(--space-6), 5vw, var(--space-7)) 0 0;
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: 400;
		line-height: 1.5;
	}

	.privacy {
		width: min(100% - (var(--space-6) * 2), var(--content-width));
		padding-bottom: clamp(var(--space-8), 8vw, 7.5rem);
		margin-inline: auto;
	}

	.privacy__block {
		max-width: 42rem;
	}

	.privacy__block + .privacy__block {
		margin-top: clamp(var(--space-7), 6vw, var(--space-8));
	}

	.privacy__block h2 {
		margin: 0 0 var(--space-5);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 360;
		line-height: 1.05;
		font-optical-sizing: auto;
	}

	.privacy__prose p {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--text-base);
		font-weight: 400;
		line-height: 1.6;
	}

	.privacy__prose p + p {
		margin-top: var(--space-5);
	}

	@media (max-width: 48rem) {
		.privacy-opening {
			width: calc(100% - (var(--space-5) * 2));
			padding-block: var(--space-8) var(--space-9);
		}

		.privacy-opening h1 {
			max-width: none;
			font-size: clamp(2.25rem, 10vw, 3rem);
			line-height: 1.05;
		}

		.privacy-opening__intro {
			max-width: none;
			margin-top: var(--space-6);
			font-size: var(--text-base);
		}

		.privacy {
			width: calc(100% - (var(--space-5) * 2));
			padding-bottom: var(--space-9);
		}

		.privacy__block {
			max-width: none;
		}
	}
</style>
