---
import { getLabels, getLocale, getLocalizedPath } from "../lib/locale";

const locale = getLocale(Astro.url.pathname);
const labels = getLabels(locale);
const leftLinks = [
	{ href: "/our-teacher", label: labels.ourTeacher },
	{ href: "/lineage", label: labels.lineage },
];

const rightLinks = [
	{ href: "/activities", label: labels.activities },
	{ href: "/padma-pura", label: labels.foundation },
	{ href: "/support", label: labels.support },
];

const membersLink = {
	href: locale === "nl" ? "/nl/leden" : "/members",
	label: labels.membersPortal,
};
const navigationLinks = [...leftLinks, ...rightLinks, membersLink];
const getHeaderPath = (href: string) => href === membersLink.href ? href : getLocalizedPath(href, locale);
---

<header class="site-header">
	<div class="site-header__inner">
		<nav class="site-header__nav site-header__nav--left" aria-label="Primary navigation">
			{leftLinks.map(({ href, label }) => <a href={getLocalizedPath(href, locale)}>{label}</a>)}
		</nav>

		<a class="site-header__identity" href={getLocalizedPath("/", locale)} aria-label="Padma Pura Foundation home">
			<img src="/brand/padma-pura-seal.png" alt="Padma Pura Foundation seal" />
		</a>

		<div class="site-header__utility">
			<a class="site-header__members-link" href={getHeaderPath(membersLink.href)}>{membersLink.label}</a>
			<nav class="site-header__language" aria-label="Language">
				<a href={getLocalizedPath(Astro.url.pathname, "en")} aria-current={locale === "en" ? "page" : undefined}>EN</a>
				<span aria-hidden="true">|</span>
				<a href={getLocalizedPath(Astro.url.pathname, "nl")} aria-current={locale === "nl" ? "page" : undefined}>NL</a>
			</nav>
		</div>

		<nav class="site-header__nav site-header__nav--right" aria-label="Primary navigation">
			{rightLinks.map(({ href, label }) => <a href={getLocalizedPath(href, locale)}>{label}</a>)}
		</nav>

		<details class="site-menu">
			<summary>Menu</summary>
			<nav aria-label="Primary navigation">
				{navigationLinks.map(({ href, label }) => <a href={getHeaderPath(href)}>{label}</a>)}
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		width: min(100% - (var(--space-6) * 2), 70rem);
		min-height: 9.5rem;
		margin-inline: auto;
	}

	.site-header__nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(var(--space-4), 1.5vw, var(--space-5));
		row-gap: var(--space-2);
		font-family: var(--font-display);
		font-size: 1.125rem;
		font-weight: 450;
		letter-spacing: 0;
		line-height: 1.3;
	}

	.site-header__nav--left {
		justify-content: flex-start;
	}

	.site-header__nav--right {
		justify-content: flex-end;
	}

	.site-header__nav a,
	.site-menu a {
		color: var(--color-foreground);
		text-decoration: none;
	}

	.site-header__nav a:hover,
	.site-menu a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.site-header__identity {
		display: block;
		width: 6rem;
		margin-inline: clamp(var(--space-6), 4vw, var(--space-8));
	}

	.site-header__utility {
		position: absolute;
		top: var(--space-4);
		right: 0;
		display: flex;
		gap: 1.125rem;
		align-items: center;
		justify-content: flex-end;
		white-space: nowrap;
	}

	.site-header__members-link,
	.site-header__language {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.4;
	}

	.site-header__members-link {
		color: var(--color-muted);
		text-decoration: none;
	}

	.site-header__members-link:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.site-header__members-link:focus-visible {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.site-header__language {
		display: flex;
		gap: var(--space-2);
		align-items: center;
	}

	.site-header__language a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.site-header__language a[aria-current="page"] {
		color: var(--color-foreground);
		font-weight: 600;
	}

	.site-header__language a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.site-header__identity img {
		display: block;
		width: 100%;
		height: auto;
	}

	.site-menu {
		display: none;
	}

	@media (max-width: 48rem) {
		.site-header__inner {
			position: relative;
			grid-template-columns: 1fr auto 1fr;
			grid-template-rows: auto auto;
			width: min(100% - (var(--space-5) * 2), 38rem);
			min-height: 7rem;
		}

		.site-header__nav {
			display: none;
		}

		.site-header__identity {
			grid-row: 1;
			grid-column: 2;
			width: 4.75rem;
			padding: var(--space-1);
			margin: 0;
		}

		.site-header__utility {
			position: static;
			grid-column: 1 / -1;
			grid-row: 1;
			justify-content: flex-start;
		}

		.site-header__members-link {
			display: none;
		}

		.site-menu {
			display: contents;
		}

		.site-menu summary {
			display: flex;
			grid-column: 3;
			grid-row: 1;
			align-self: center;
			justify-self: end;
			align-items: center;
			min-height: 2.75rem;
			cursor: pointer;
			color: var(--color-foreground);
			font-family: var(--font-display);
			font-size: 1.125rem;
			font-weight: 450;
			letter-spacing: 0;
			line-height: 1.3;
			list-style: none;
		}

		.site-menu summary::-webkit-details-marker {
			display: none;
		}

		.site-menu nav {
			display: grid;
			grid-column: 1 / -1;
			grid-row: 2;
			gap: var(--space-1);
			width: 100%;
			margin-top: var(--space-4);
			padding-top: var(--space-3);
			padding-bottom: var(--space-5);
			border-top: 1px solid var(--color-border);
		}

		.site-menu a {
			display: flex;
			align-items: center;
			min-height: 2.75rem;
			font-family: var(--font-display);
			font-size: 1.125rem;
			font-weight: 450;
			letter-spacing: 0;
			line-height: 1.3;
		}
	}
</style>